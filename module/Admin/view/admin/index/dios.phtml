// URL building helper (no rompe si la ruta tiene segmentos)
// Guardado con function_exists(): esta plantilla se reutiliza para 4 rutas
// distintas (moderadores/ceoAdmins/diosCeo/diosDios) y en SAPIs de proceso
// persistente (php -S, workers de test) puede incluirse más de una vez por
// proceso; sin la guarda, la segunda inclusión provoca un fatal "Cannot redeclare".
$basePathTrim = rtrim((string) $this->basePath(), '/');
if (!function_exists('urlFull')) {
    function urlFull(string $basePath, string $baseCL, string $suffix = ''): string {
        return $basePath . '/' . str_replace('.', '/', $baseCL) . $suffix;
    }
}

if (!function_exists('fmtDate')) {
    function fmtDate(?string $iso, string $pattern = 'd - m - Y H:i'): string {
        if (empty($iso)) return '';
        try { return (new DateTime($iso))->format($pattern); }
        catch (\Throwable $e) { return ''; }
    }
}

if (!function_exists('eav')) {
    function eav($v): string {
        return htmlspecialchars((string)($v ?? ''), ENT_QUOTES, 'UTF-8');
    }
}
