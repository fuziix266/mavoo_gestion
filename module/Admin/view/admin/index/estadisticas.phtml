<?php $this->inlineScript()->appendFile($this->basePath('assets/vendor/apexcharts/apexcharts.min.js')); ?>

<?php $this->inlineScript()->captureStart(); ?>
(function () {
    var meses       = <?= json_encode($meses, JSON_UNESCAPED_UNICODE) ?>;
    var nuevos      = <?= json_encode($nuevos, JSON_UNESCAPED_UNICODE) ?>;
    var paises      = <?= json_encode($paises, JSON_UNESCAPED_UNICODE) ?>;
    var usuariosPais = <?= json_encode($usuariosPais, JSON_UNESCAPED_UNICODE) ?>;
    var generoLabels = <?= json_encode($generoLabels, JSON_UNESCAPED_UNICODE) ?>;
    var generoData   = <?= json_encode($generoData, JSON_UNESCAPED_UNICODE) ?>;
    var whatsappSeries = [<?= (int)($usuariosConWhatsapp ?? 0) ?>, <?= (int)($sinWhatsapp ?? 0) ?>];
    var buckets = ['1 número', '2 números', '3+ números'];
    var bucketSeries = [<?= (int)($usuarios1 ?? 0) ?>, <?= (int)($usuarios2 ?? 0) ?>, <?= (int)($usuarios3mas ?? 0) ?>];
    var rangosEdad = <?= json_encode($rangosEdad, JSON_UNESCAPED_UNICODE) ?>;
    var usuariosPorEdad = <?= json_encode($usuariosPorEdadData, JSON_UNESCAPED_UNICODE) ?>;

    if (typeof ApexCharts === 'undefined') {
        console.error('ApexCharts no está cargado');
        return;
    }

    new ApexCharts(document.querySelector('#chartNuevosPorMes'), {
        chart: { type: 'line', height: 320, toolbar: { show: false } },
        series: [{ name: 'Nuevos', data: nuevos }],
        xaxis: { categories: meses },
        stroke: { width: 3 },
        markers: { size: 4 },
        grid: { strokeDashArray: 4 }
    }).render();

    new ApexCharts(document.querySelector('#chartPaises'), {
        chart: { type: 'bar', height: 360, toolbar: { show: false } },
        series: [{ name: 'Usuarios', data: usuariosPais }],
        xaxis: { categories: paises },
        plotOptions: { bar: { horizontal: true, borderRadius: 6 } },
        grid: { strokeDashArray: 4 }
    }).render();

    new ApexCharts(document.querySelector('#chartGenero'), {
        chart: { type: 'donut', height: 320, toolbar: { show: false } },
        series: generoData,
        labels: generoLabels,
        legend: { position: 'bottom' }
    }).render();

    new ApexCharts(document.querySelector('#chartWhatsappSiNo'), {
        chart: { type: 'donut', height: 320, toolbar: { show: false } },
        series: whatsappSeries,
        labels: ['Con WhatsApp', 'Sin WhatsApp'],
        legend: { position: 'bottom' }
    }).render();

    new ApexCharts(document.querySelector('#chartCantidadWhatsapp'), {
        chart: { type: 'bar', height: 320, toolbar: { show: false } },
        series: [{ name: 'Usuarios', data: bucketSeries }],
        xaxis: { categories: buckets },
        plotOptions: { bar: { columnWidth: '45%', borderRadius: 6 } },
        grid: { strokeDashArray: 4 }
    }).render();

    new ApexCharts(document.querySelector('#chartEdades'), {
        chart: { type: 'bar', height: 320, toolbar: { show: false } },
        series: [{ name: 'Usuarios', data: usuariosPorEdad }],
        xaxis: { categories: rangosEdad },
        plotOptions: { bar: { columnWidth: '45%', borderRadius: 6 } },
        grid: { strokeDashArray: 4 }
    }).render();
})();
<?php $this->inlineScript()->captureEnd(); ?>
