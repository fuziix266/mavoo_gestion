<?php
/**
 * Estadísticas - Laminas view
 * Reescrito: sin BOM, sin mojibake, sin sintaxis Blade {!! !!}.
 *
 * Variables inyectadas (array/Collection de PHP puro) desde IndexController:
 *   $tituloCL, $totalUsuarios, $porcConFoto, $porcConWhatsapp, $promWhatsapp,
 *   $nuevosUsuariosPorMes, $usuariosPorPais, $genero, $sinWhatsapp, $usuariosConWhatsapp,
 *   $usuarios1, $usuarios2, $usuarios3mas, $usuariosPorEdad.
 */
extract($this->vars()->getArrayCopy());

// ---- Normalizar variables para JS (arrays asociativos PHP) ----
$meses          = isset($nuevosUsuariosPorMes) ? array_keys($nuevosUsuariosPorMes)   : [];
$nuevos         = isset($nuevosUsuariosPorMes) ? array_values($nuevosUsuariosPorMes) : [];

// El controlador (estadisticasAction) pasa la variable como $paisesRaw, no
// $usuariosPorPais; con el nombre viejo esto siempre quedaba vacío y el
// gráfico de "usuarios por país" nunca mostraba datos.
$paisesData     = $paisesRaw ?? [];
$paises         = [];
$usuariosPais   = [];
foreach ($paisesData as $row) {
    $rowArr = (array) $row;
    $paises[]       = $rowArr['pais']   ?? 'N/D';
    $usuariosPais[] = (int) ($rowArr['total'] ?? 0);
}

$generoLabels   = isset($genero) ? array_keys((array)$genero)   : [];
$generoData     = isset($genero) ? array_values((array)$genero) : [];

$rangosEdad     = isset($usuariosPorEdad) ? array_keys((array)$usuariosPorEdad)   : [];
$usuariosPorEdadData = isset($usuariosPorEdad) ? array_values((array)$usuariosPorEdad) : [];
?>
