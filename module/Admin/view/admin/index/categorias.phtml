<?php $this->inlineScript()->captureStart(); ?>
(function() {
    const RUTAS = {
        listar: (alias) => "<?= $this->url('admin.ceo.categorias/listar', ['alias' => 'ALIAS_PLACEHOLDER']) ?>".replace('ALIAS_PLACEHOLDER', encodeURIComponent(alias)),
        orden:  "<?= $this->url('admin.ceo.categorias/orden') ?>",
        store:  "<?= $this->url('admin.ceo.categorias/store') ?>",
        update: (uuid) => "<?= $this->url('admin.ceo.categorias/update', ['uuid' => 'UUID_PLACEHOLDER']) ?>".replace('UUID_PLACEHOLDER', encodeURIComponent(uuid)),
    };

    const csrf = ""; // CSRF no activo en api REST simple
    const lista = document.getElementById('listaCategorias');
    const tpl   = document.getElementById('tplItem');
    const empty = document.getElementById('emptyState');

    const alertaSeleccion = document.getElementById('alertaSeleccion');
    const cabeceraDeporte = document.getElementById('cabeceraDeporte');
    const btnSeleccionarDeporte = document.getElementById('btnSeleccionarDeporte');
    const btnCambiarDeporte = document.getElementById('btnCambiarDeporte');
    const btnAgregar = document.getElementById('btnAgregarCategoria');
    const modalDeportesEl = document.getElementById('modalDeportes');
    const modalCategoriaEl = document.getElementById('modalCategoria');

    const deporteNombreEl = document.getElementById('deporteNombre');
    const deporteAliasEl  = document.getElementById('deporteAlias');

    const iconGrid = document.getElementById('iconGrid');
    const inputIcono = document.getElementById('icono');
    const inputTitulo = document.getElementById('titulo');
    const inputSubtitulo = document.getElementById('subtitulo');
    const lblGuardar = document.getElementById('lblGuardar');
    const inputUuid = document.getElementById('categoriaUuid');
    const formCategoria = document.getElementById('formCategoria');

    let deporteSeleccionado = { alias: null, nombre: null };
    let modalDeportes, modalCategoria, sortable;

    function extraerClaseIcono(htmlIcono) {
        if (!htmlIcono || typeof htmlIcono !== 'string') {
            return null;
        }
        // Crea un elemento temporal para parsear la cadena HTML
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = htmlIcono.trim();

        const iconoEl = tempDiv.querySelector('i');
        if (iconoEl) {
            // Obtiene todas las clases
            const clases = Array.from(iconoEl.classList);
            // Filtra para obtener solo las clases que estÃ¡n en el formato de tu lista
            // AquÃ­ asumimos que todos tus iconos empiezan con 'ti ti-'
            const claseIcono = clases.filter(c => c.startsWith('ti-')).join(' ');

            // Para ser mÃ¡s robustos y evitar que se incluya 'text-primary',
            // Buscamos las dos clases base que definen el icono: 'ti' y 'ti-NOMBRE'
            // O, si son de Tabler Icons, a menudo son 'ti' y 'ti-icon-name'
            // Tu lista tiene 'ti ti-trophy'. Buscamos esas dos.

            // Simplificando y asumiendo que el prefijo es 'ti ti-NOMBRE'
            // Si la cadena de clases contiene 'ti ti-' y el nombre del icono
            const match = htmlIcono.match(/class="(.*?)"/);
            if (match && match[1]) {
                const todasLasClases = match[1].split(' ');
                // Filtramos las clases para reconstruir la cadena 'ti ti-nombre'
                const clasesIcono = todasLasClases.filter(clase => clase === 'ti' || clase.startsWith('ti-'));
                // Eliminamos duplicados y unimos, forzando que empiece por 'ti ti-'
                if (clasesIcono.includes('ti') && clasesIcono.length > 1) {
                    return 'ti ' + clasesIcono.filter(c => c !== 'ti').join(' ');
                }
            }
            // Si el parsing fue demasiado complejo, intentamos una soluciÃ³n simple de reemplazo
            // que se basa en que 'ti ti-book' estÃ¡ dentro de la cadena HTML.
            // La expresiÃ³n regular: busca 'ti ti-' seguido de cualquier palabra hasta el siguiente espacio o comilla.
            const simpleMatch = htmlIcono.match(/(ti ti-[a-z0-9-]+)/);
            if (simpleMatch) {
                return simpleMatch[1];
            }
        }
        return null;
    }

    function toggleEmptyState() {
        const hasItems = lista.children.length > 0;
        empty.classList.toggle('hidden', hasItems);
    }

    function limpiarLista() {
        lista.innerHTML = '';
        toggleEmptyState();
    }

    function renderItem(cat) {
        const li = tpl.content.firstElementChild.cloneNode(true);
        li.dataset.uuid = cat.uuid;
        li.querySelector('.item-titulo').textContent = cat.titulo;
        li.querySelector('.item-subtitulo').textContent = cat.subtitulo || '';
        // Mostrar icono desde BD o default
        li.querySelector('.h-40.w-40').innerHTML = (cat.icono || '<i class="ti ti-trophy icono-lista"></i>').replace('text-primary', 'icono-lista');
        li.querySelector('.btnEditar').addEventListener('click', () => abrirEditar(cat));
        lista.appendChild(li);
    }

    async function cargarCategorias(alias) {
        limpiarLista();
        try {
            const res = await fetch(RUTAS.listar(alias), { headers: { 'Accept': 'application/json' }});
            const data = await res.json();
            (data.categorias || []).forEach(renderItem);
            toggleEmptyState();
            initSortable();
        } catch (e) {
            console.error(e);
        } finally {
            cerrarCargando();
        }
    }

    function initSortable() {
        if (sortable) sortable.destroy();
        // Requiere SortableJS ya cargado en el layout
        sortable = Sortable.create(lista, {
            handle: '.list-handle',
            animation: 150,
            onEnd: guardarOrden
        });
    }

    async function guardarOrden() {
        const orden = Array.from(lista.children).map((li, idx) => ({
            uuid: li.dataset.uuid,
            posicion: idx + 1
        }));
        try {
            await fetch(RUTAS.orden, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': csrf,
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ orden })
            });
        } catch (e) {
            console.error(e);
        } finally {
            cerrarCargando();
        }
    }

    function abrirCrear() {
        inputUuid.value = '';
        inputTitulo.value = '';
        inputSubtitulo.value = '';
        seleccionarIconoUI(null); // limpia selecciÃ³n
        inputIcono.value = '';
        lblGuardar.textContent = "Nueva Categoría";
        document.getElementById('modalCategoriaTitulo').textContent = "Añadir Categoría";
        limpiarErrores();
        modalCategoria.show();
    }

    function abrirEditar(cat) {
        inputUuid.value = cat.uuid;
        inputTitulo.value = cat.titulo || '';
        inputSubtitulo.value = cat.subtitulo || '';
        const clasePuraIcono = extraerClaseIcono(cat.icono);
        seleccionarIconoUI(clasePuraIcono);
        inputIcono.value = clasePuraIcono || ''; 
        lblGuardar.textContent = "Guardar Cambios";
        document.getElementById('modalCategoriaTitulo').textContent = "Editar Categoría";
        limpiarErrores();
        modalCategoria.show();
    }

    function limpiarErrores() {
        ['titulo','subtitulo','icono'].forEach(id => {
            const input = document.getElementById(id) || {};
            if (input.classList) input.classList.remove('is-invalid');
            const err = document.getElementById('error_' + id);
            if (err) err.textContent = '';
        });
    }

    function seleccionarIconoUI(icon) {
        Array.from(iconGrid.querySelectorAll('.icon-option')).forEach(opt => {
            opt.classList.toggle('active', opt.dataset.icon === icon);
        });
    }

    iconGrid.addEventListener('click', (e) => {
        const opt = e.target.closest('.icon-option');
        if (!opt) return;
        seleccionarIconoUI(opt.dataset.icon);
        inputIcono.value = opt.dataset.icon;
    });

    formCategoria.addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarErrores();

        if (!deporteSeleccionado.alias) return;

        const payload = {
            icono: inputIcono.value,
            titulo: inputTitulo.value,
            subtitulo: inputSubtitulo.value,
            deporte: deporteSeleccionado.alias
        };
        const isEdit = !!inputUuid.value;
        const url = isEdit ? RUTAS.update(inputUuid.value) : RUTAS.store;
        const method = isEdit ? 'PUT' : 'POST';

        try {
            const res = await fetch(url, {
                method,
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': csrf,
                    'Accept': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (res.status === 422) {
                const data = await res.json();
                const errs = data.errors || {};
                if (errs.titulo) { inputTitulo.classList.add('is-invalid'); document.getElementById('error_titulo').textContent = errs.titulo[0]; }
                if (errs.subtitulo) { inputSubtitulo.classList.add('is-invalid'); document.getElementById('error_subtitulo').textContent = errs.subtitulo[0]; }
                if (errs.icono) { alert(errs.icono[0]); }
                return;
            }

            await res.json();
            await cargarCategorias(deporteSeleccionado.alias);
            modalCategoria.hide();
        } catch (err) {
            console.error(err);
        } finally {
            cerrarCargando();
        }
    });

    // Abrir selector de deportes
    btnSeleccionarDeporte.addEventListener('click', () => modalDeportes.show());
    btnCambiarDeporte.addEventListener('click', () => modalDeportes.show());

    // Elegir deporte
    modalDeportesEl.addEventListener('click', async (e) => {
        const btn = e.target.closest('.btnElegirDeporte');
        if (!btn) return;
        deporteSeleccionado = { alias: btn.dataset.alias, nombre: btn.dataset.nombre };
        deporteNombreEl.textContent = deporteSeleccionado.nombre;
        deporteAliasEl.textContent = deporteSeleccionado.alias;

        cabeceraDeporte.classList.remove('hidden');
        btnAgregar.classList.remove('hidden');
        alertaSeleccion.classList.add('hidden');

        modalDeportes.hide();
        await cargarCategorias(deporteSeleccionado.alias);
    });

    // Agregar nueva
    btnAgregar.addEventListener('click', abrirCrear);

    // Init modals
    document.addEventListener('DOMContentLoaded', () => {
        modalDeportes = new bootstrap.Modal(modalDeportesEl);
        modalCategoria = new bootstrap.Modal(modalCategoriaEl);
    });
})();
