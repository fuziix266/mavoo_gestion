<?php $this->inlineScript()->captureStart(); ?>
(function ($) {
    'use strict';

    var URL_BUSCAR_USUARIO = '<?= $this->url('admin.ceo.usuarios/buscar_usuario') ?>';
    var URL_BUSCAR_ACCESO  = '<?= $this->url('admin.ceo.accesos/buscar-por-deporte', ['deporte_uuid' => 'UUID_PLACEHOLDER']) ?>';
    var URL_LISTAR         = '<?= $this->url('admin.ceo.accesos/listar') ?>';

    function initSelect2Usuarios($el, dropdownParent) {
        $el.select2({
            dropdownParent: dropdownParent || $(document.body),
            placeholder: 'Buscar usuario...',
            minimumInputLength: 2,
            ajax: {
                url: URL_BUSCAR_USUARIO,
                dataType: 'json',
                delay: 250,
                data: function (params) { return { q: params.term || '', page: params.page || 1 }; },
                processResults: function (data) {
                    return { results: data.results || [], pagination: { more: data.more || false } };
                },
                cache: true
            }
        });
    }

    function initSelect2Accesos($el, deporteUuid, dropdownParent) {
        $el.select2({
            dropdownParent: dropdownParent || $(document.body),
            placeholder: 'Buscar acceso...',
            minimumInputLength: 0,
            ajax: {
                url: URL_BUSCAR_ACCESO.replace('UUID_PLACEHOLDER', encodeURIComponent(deporteUuid)),
                dataType: 'json',
                delay: 200,
                data: function (params) { return { q: params.term || '', page: params.page || 1 }; },
                processResults: function (data) {
                    return { results: data.results || [], pagination: { more: data.more || false } };
                },
                cache: true
            }
        });
    }

    // Modal LISTAR
    var $modalListar = $('#modalListarAccesos');
    var $selDepL = $('#listar_deporte_uuid');
    var $selAccL = $('#listar_acceso_uuid');

    $modalListar.on('shown.bs.modal', function () {
        $selAccL.empty().trigger('change');
        $selDepL.off('change').on('change', function () {
            $selAccL.val(null).trigger('change').empty();
            var dep = $(this).val();
            if (dep) initSelect2Accesos($selAccL, dep, $modalListar);
        });
    });

    $('#formListarAccesos').on('submit', function (e) {
        e.preventDefault();
        var deporteUuid = $selDepL.val();
        var accesoUuid  = $selAccL.val();
        if (!deporteUuid || !accesoUuid) return;

        fetch(URL_LISTAR, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ deporte_uuid: deporteUuid, acceso_uuid: accesoUuid })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            $('#tbodyUsuariosAcceso').html(data.html || '');
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#tablaUsuariosAcceso')) {
                $('#tablaUsuariosAcceso').DataTable().destroy();
            }
            if ($.fn.DataTable) {
                $('#tablaUsuariosAcceso').DataTable({
                    language: { zeroRecords: 'Sin resultados', info: 'Mostrando _START_ a _END_ de _TOTAL_' }
                });
            }
        })
        .catch(function (err) { console.error('Error listando accesos:', err); });
    });

    // Modal OTORGAR
    var $modalOtorgar = $('#modalOtorgarAcceso');
    var $selUser = $('#usuario_id');
    var $selDepO = $('#otorgar_deporte_uuid');
    var $selAccO = $('#otorgar_acceso_uuid');

    $modalOtorgar.on('shown.bs.modal', function () {
        initSelect2Usuarios($selUser, $modalOtorgar);
        $selAccO.empty().trigger('change');
        $selDepO.off('change').on('change', function () {
            $selAccO.val(null).trigger('change').empty();
            var dep = $(this).val();
            if (dep) initSelect2Accesos($selAccO, dep, $modalOtorgar);
        });
    });
})(jQuery);
<?php $this->inlineScript()->captureEnd(); ?>
