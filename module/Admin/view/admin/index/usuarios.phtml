// Cargar scripts necesarios (se agregarán al final del body vía inlineScript)
$this->inlineScript()
    ->appendFile($this->basePath('assets/vendor/select/select2.min.js'))
    ->appendFile($this->basePath('assets/vendor/datatable/jquery.dataTables.min.js'));

$this->inlineScript()->captureStart();
?>
$(document).ready(function () {
    var urlBuscar = '<?= $this->url($baseCL . '/buscar_usuario') ?>';
    var tplModal = '<?= $this->url($baseCL . '/modal', ['user' => 'ID_PLACEHOLDER']) ?>';

    var $sel = $('.select2-ajax').select2({
        width: '100%',
        dropdownParent: $(document.body),
        placeholder: '<?= htmlspecialchars(__('dios.js1'), ENT_QUOTES, 'UTF-8') ?>',
        minimumInputLength: 2,
        ajax: {
            url: urlBuscar,
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return { q: params.term, page: params.page || 1 };
            },
            processResults: function (data, params) {
                params.page = params.page || 1;
                return {
                    results: data.results || [],
                    pagination: { more: data.more || false }
                };
            },
            cache: true
        },
        language: {
            inputTooShort: function () { return '<?= htmlspecialchars(__('dios.js2'), ENT_QUOTES, 'UTF-8') ?>'; },
            searching: function () { return '<?= htmlspecialchars(__('dios.js3'), ENT_QUOTES, 'UTF-8') ?>'; },
            noResults: function () { return '<?= htmlspecialchars(__('dios.js4'), ENT_QUOTES, 'UTF-8') ?>'; },
            loadingMore: function () { return '<?= htmlspecialchars(__('dios.js5'), ENT_QUOTES, 'UTF-8') ?>'; },
            errorLoading: function () { return 'Error'; }
        }
    });

    $('.select2-search__field').prop('disabled', false);

    $('.select2-ajax').on('select2:select', function (e) {
        var userId = e.params.data.id;
        var urlModal = tplModal.replace('ID_PLACEHOLDER', encodeURIComponent(userId));

        fetch(urlModal, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(function (html) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                var form = doc.querySelector('form');
                if (!form) return;

                var clone = form.cloneNode(true);
                clone.querySelectorAll('input, select, textarea').forEach(function (el) {
                    el.disabled = true;
                });

                var btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = '<?= htmlspecialchars(__('dios.btn_editar'), ENT_QUOTES, 'UTF-8') ?>';
                btn.className = 'btn btn-primary mt-3';
                btn.addEventListener('click', function () {
                    document.getElementById('modal-container').innerHTML = html;
                    var modalEl = doc.querySelector('.modal');
                    if (modalEl && modalEl.id) {
                        var modal = new bootstrap.Modal(document.getElementById(modalEl.id));
                        modal.show();
                    }
                });

                var detalle = document.getElementById('usuario_detalle');
                detalle.innerHTML = '';
                detalle.appendChild(clone);
                detalle.appendChild(btn);
                detalle.scrollIntoView({ behavior: 'smooth' });
            })
            .catch(function (err) { console.error('Error cargando datos del usuario:', err); });
    });
});
<?php
$this->inlineScript()->captureEnd();
?>
