<script>
document.addEventListener('DOMContentLoaded', function () {
    <?php if ($hasRole('dios') && !empty($genderData)): ?>
    // Gráfico de género (para rol dios)
    const genderData = <?= json_encode($genderData ?? []) ?>;
    const gCounts = genderData.map(i => i.count);
    const gLabels = genderData.map(i => i.label);
    const gTotal  = gCounts.reduce((a, b) => a + b, 0);
    const gColors = gLabels.map(l => {
        switch(l) {
            case 'Masculino': return '#0d6efd';
            case 'Femenino':  return '#dc3545';
            case 'Otro':      return '#0dcaf0';
            default:          return '#ffc107';
        }
    });
    const gCtx = document.getElementById('genderDistributionChart');
    if (gCtx) {
        new Chart(gCtx, {
            type: 'doughnut',
            data: { labels: gLabels, datasets: [{ data: gCounts, backgroundColor: gColors, hoverOffset: 4 }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 20 } },
                    tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.parsed} (${((ctx.parsed/gTotal)*100).toFixed(1)}%)` } }
                }
            }
        });
    }
    <?php endif; ?>
});
</script>
