    display: inline-flex;
    align-items: center;
    gap: .35rem;
    transition: var(--mavoo-transition);
}
.breadcrumb-item a:hover { color: var(--mavoo-primary); }
.breadcrumb-item + .breadcrumb-item::before {
    content: '›';
    color: var(--mavoo-ink-400);
    font-weight: 600;
    padding-right: .5rem;
}
.breadcrumb-item.active {
    color: var(--mavoo-ink-900);
    font-weight: 600;
