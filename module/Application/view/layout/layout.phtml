.mavoo-nav .main-nav > li > ul.submenu {
    border: 1px solid var(--mavoo-ink-200) !important;
    border-radius: var(--mavoo-radius-lg) !important;
    box-shadow: var(--mavoo-shadow-lg) !important;
    padding: .5rem !important;
    animation: submenuIn .18s cubic-bezier(.4, 0, .2, 1);
}
@keyframes submenuIn {
    from { opacity: 0; transform: translateY(-6px) scale(.98); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
}
.mavoo-nav .main-nav > li > ul.submenu li a {
    border-radius: 8px !important;
    margin: 2px 0;
    transition: var(--mavoo-transition);
}
.mavoo-nav .main-nav > li > ul.submenu li a:hover {
    background: var(--mavoo-primary-50) !important;
    color: var(--mavoo-primary) !important;
    padding-left: 1.5rem !important;
}
.mavoo-nav .main-nav > li > ul.submenu li a:hover::before {
    content: '→';
    position: absolute;
    margin-left: -.9rem;
    color: var(--mavoo-cyan);
    font-weight: 700;
}

/* ============================================================
   PAGE — superficie del contenido
   ============================================================ */
.mavoo-page {
    background: var(--mavoo-white) !important;
    border-radius: 0 0 var(--mavoo-radius-lg) var(--mavoo-radius-lg) !important;
    box-shadow: 0 1px 0 rgba(15, 23, 42, .02);
}

/* ============================================================
   CARDS — superficies pulidas con jerarquía clara
   ============================================================ */
.card {
    background: var(--mavoo-white);
    border: 1px solid var(--mavoo-ink-200);
    border-radius: var(--mavoo-radius-lg);
    box-shadow: var(--mavoo-shadow-xs);
    transition: var(--mavoo-transition);
    overflow: hidden;
}
.card:hover { box-shadow: var(--mavoo-shadow-sm); }
.card-header {
    background: linear-gradient(180deg, var(--mavoo-ink-50) 0%, var(--mavoo-white) 100%);
    border-bottom: 1px solid var(--mavoo-ink-200);
    padding: 1rem 1.25rem;
    font-weight: 600;
    color: var(--mavoo-ink-900);
}
.card-header h5,
.card-header h4,
.card-header h6 {
    color: var(--mavoo-ink-900);
    font-weight: 700;
    letter-spacing: -.01em;
    margin: 0;
}
.card-header h5::before,
.card-header h4::before {
    content: '';
    display: inline-block;
    width: 4px; height: 18px;
    background: var(--mavoo-gradient);
    border-radius: 4px;
    margin-right: .6rem;
    vertical-align: -3px;
}
.card-body { padding: 1.25rem 1.5rem; }
.card-footer {
    background: var(--mavoo-ink-50);
    border-top: 1px solid var(--mavoo-ink-200);
    padding: .9rem 1.25rem;
}

/* ============================================================
   FORM CONTROLS — más aire, bordes pulidos, focus claro
   ============================================================ */
.form-label {
    font-size: .82rem;
    font-weight: 600;
    color: var(--mavoo-ink-700);
    margin-bottom: .4rem;
    letter-spacing: .01em;
    text-transform: uppercase;
}
.form-label::before {
    content: '';
    display: inline-block;
    width: 3px; height: 12px;
    background: var(--mavoo-primary);
    border-radius: 2px;
    margin-right: .45rem;
    vertical-align: -1px;
    opacity: .85;
}

.form-control,
.form-select,
.form-control:focus,
.form-select:focus {
    font-family: inherit;
    font-size: .92rem;
    /* !important: el bundle compilado de Ki Admin (build/assets/style-*.css)
       redefine --bs-body-color a partir de su propia variable --link-color
       (#00d3d3), y Bootstrap usa esa variable para el color de texto de
       .form-control -> todos los inputs quedaban en cian en vez de un
       color de texto legible. */
    color: var(--mavoo-ink-900) !important;
    background-color: var(--mavoo-white);
    border: 1.5px solid var(--mavoo-ink-200);
    border-radius: var(--mavoo-radius);
    padding: .62rem .9rem;
    line-height: 1.45;
    transition: var(--mavoo-transition);
    box-shadow: none;
    min-height: 42px;
}
.form-control:hover:not(:disabled):not([readonly]),
.form-select:hover:not(:disabled) {
    border-color: var(--mavoo-ink-300);
}
.form-control:focus,
.form-select:focus {
    border-color: var(--mavoo-primary);
    background-color: var(--mavoo-white);
    box-shadow: var(--mavoo-ring);
    outline: none;
}
.form-control::placeholder {
    color: var(--mavoo-ink-400);
    font-weight: 400;
}
.form-control:disabled,
.form-control[readonly],
.form-select:disabled {
    background-color: var(--mavoo-ink-100);
    color: var(--mavoo-ink-500);
    cursor: not-allowed;
    opacity: .9;
}
.form-control[type="file"] {
    padding: .5rem;
    background: var(--mavoo-ink-50);
}
.form-control[type="file"]::-webkit-file-upload-button {
    background: var(--mavoo-gradient);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: .35rem .8rem;
    margin-right: .8rem;
    font-weight: 600;
    font-size: .82rem;
    cursor: pointer;
    transition: var(--mavoo-transition);
}
.form-control[type="file"]::-webkit-file-upload-button:hover {
    transform: translateY(-1px);
    box-shadow: var(--mavoo-shadow-primary);
}

/* Inputs de fecha/hora: mejor legibilidad */
input[type="date"].form-control,
input[type="datetime-local"].form-control,
input[type="time"].form-control {
    font-variant-numeric: tabular-nums;
}

/* Textarea */
textarea.form-control {
    min-height: 110px;
    resize: vertical;
}

/* Select arrow — más limpio */
.form-select {
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='none' stroke='%23475569' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3E%3C/svg%3E");
    background-position: right .9rem center;
    background-size: 14px 12px;
    padding-right: 2.25rem;
}

/* Select2 (sobrescribe si está cargado) */
.select2-container--default .select2-selection--single {
    height: 42px !important;
    border: 1.5px solid var(--mavoo-ink-200) !important;
    border-radius: var(--mavoo-radius) !important;
    background: var(--mavoo-white) !important;
    transition: var(--mavoo-transition);
}
.select2-container--default .select2-selection--single:hover {
    border-color: var(--mavoo-ink-300) !important;
}
.select2-container--default.select2-container--focus .select2-selection--single,
.select2-container--default.select2-container--open .select2-selection--single {
    border-color: var(--mavoo-primary) !important;
    box-shadow: var(--mavoo-ring) !important;
}
.select2-container--default .select2-selection--single .select2-selection__rendered {
    line-height: 40px !important;
    color: var(--mavoo-ink-900) !important;
    padding-left: .9rem !important;
    font-size: .92rem !important;
}
.select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 40px !important;
    right: .8rem !important;
}
.select2-dropdown {
    border: 1px solid var(--mavoo-ink-200) !important;
    border-radius: var(--mavoo-radius) !important;
    box-shadow: var(--mavoo-shadow-lg) !important;
    overflow: hidden;
}
.select2-container--default .select2-results__option--highlighted[aria-selected] {
    background: var(--mavoo-primary) !important;
    color: #fff !important;
}
.select2-container--default .select2-search--dropdown .select2-search__field {
    border: 1.5px solid var(--mavoo-ink-200) !important;
    border-radius: 8px !important;
    padding: .5rem .75rem !important;
}

/* Checkboxes y radios */
.form-check {
    padding-left: 1.85em;
    min-height: 1.6em;
    margin-bottom: .5rem;
}
.form-check-input {
    width: 1.15em;
    height: 1.15em;
    margin-top: .22em;
    border: 1.5px solid var(--mavoo-ink-300);
    background-color: var(--mavoo-white);
    transition: var(--mavoo-transition);
    cursor: pointer;
}
.form-check-input:hover { border-color: var(--mavoo-primary); }
.form-check-input:checked {
    background-color: var(--mavoo-primary);
    border-color: var(--mavoo-primary);
    box-shadow: 0 0 0 3px rgba(var(--mavoo-primary-rgb), .15);
}
.form-check-input[type="radio"] { border-radius: 50%; }
.form-check-input:focus {
    border-color: var(--mavoo-primary);
    box-shadow: var(--mavoo-ring);
}
.form-check-input[type="checkbox"]:indeterminate {
    background-color: var(--mavoo-primary);
    border-color: var(--mavoo-primary);
}
.form-check-label {
    color: var(--mavoo-ink-700);
    font-size: .92rem;
    cursor: pointer;
    user-select: none;
}

/* Switch */
.form-switch .form-check-input {
    width: 2.25em;
    height: 1.35em;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3E%3Ccircle r='3' fill='%2394A3B8'/%3E%3C/svg%3E");
    transition: var(--mavoo-transition);
}
.form-switch .form-check-input:checked {
    background-color: var(--mavoo-primary);
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3E%3Ccircle r='3' fill='%23fff'/%3E%3C/svg%3E");
}

/* Form helper texts */
.form-text {
    color: var(--mavoo-ink-500);
    font-size: .8rem;
    margin-top: .35rem;
}
.invalid-feedback {
    color: var(--mavoo-danger);
    font-size: .8rem;
    font-weight: 500;
    margin-top: .35rem;
}
.form-control.is-invalid,
.form-select.is-invalid {
    border-color: var(--mavoo-danger);
    box-shadow: 0 0 0 4px rgba(var(--mavoo-danger-rgb), .12);
}

/* Espaciado entre campos del form (en .row > .col-*) */
.app-form .row,
.app-form > .row { row-gap: 0; }
.app-form .mb-3 { margin-bottom: 1.15rem !important; }

/* ============================================================
   BUTTONS — modernos, con microinteracciones
   ============================================================ */
.btn {
    font-family: inherit;
    font-weight: 600;
    font-size: .88rem;
    letter-spacing: .01em;
    border-radius: var(--mavoo-radius);
    padding: .58rem 1.15rem;
    border: 1.5px solid transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    line-height: 1.2;
    cursor: pointer;
    transition: var(--mavoo-transition);
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    user-select: none;
}
.btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(255,255,255,.35) 0%, transparent 60%);
    opacity: 0;
    transition: opacity .4s ease;
    pointer-events: none;
}
.btn:hover::after { opacity: 1; }
.btn:focus-visible {
    outline: none;
    box-shadow: var(--mavoo-ring);
}
.btn:active { transform: translateY(1px) scale(.99); }
.btn:disabled,
.btn.disabled {
    opacity: .55;
    cursor: not-allowed;
    transform: none !important;
}

/* Primary — ancla de marca */
.btn-primary {
    background: var(--mavoo-gradient) !important;
    background-size: 200% 200% !important;
    background-position: 0% 50% !important;
    border: none !important;
    color: #fff !important;
    box-shadow: 0 4px 12px rgba(var(--mavoo-primary-rgb), .28);
}
.btn-primary:hover {
    background-position: 100% 50% !important;
    box-shadow: 0 8px 22px rgba(var(--mavoo-primary-rgb), .38);
    transform: translateY(-2px);
    color: #fff !important;
}
.btn-primary:focus,
.btn-primary:focus-visible {
    background: var(--mavoo-gradient) !important;
    color: #fff !important;
    box-shadow: 0 0 0 4px rgba(var(--mavoo-primary-rgb), .25), 0 8px 22px rgba(var(--mavoo-primary-rgb), .38) !important;
}

/* Outline primary */
.btn-outline-primary {
    background: transparent;
    color: var(--mavoo-primary);
    border: 1.5px solid var(--mavoo-primary);
}
.btn-outline-primary:hover {
    background: var(--mavoo-primary);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(var(--mavoo-primary-rgb), .30);
}

/* Success */
.btn-success {
    background: var(--mavoo-success);
    border: none;
    color: #fff;
    box-shadow: 0 4px 12px rgba(var(--mavoo-success-rgb), .30);
}
.btn-success:hover {
    background: #0EA572;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(var(--mavoo-success-rgb), .40);
    color: #fff;
}
.btn-outline-success {
    background: transparent;
    color: var(--mavoo-success);
    border: 1.5px solid var(--mavoo-success);
}
.btn-outline-success:hover {
    background: var(--mavoo-success);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(var(--mavoo-success-rgb), .30);
}

/* Warning */
.btn-warning {
    background: var(--mavoo-warning);
    border: none;
    color: #fff;
    box-shadow: 0 4px 12px rgba(var(--mavoo-warning-rgb), .32);
}
.btn-warning:hover {
    background: #D97706;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(var(--mavoo-warning-rgb), .42);
    color: #fff;
}
.btn-outline-warning {
    background: transparent;
    color: var(--mavoo-warning);
    border: 1.5px solid var(--mavoo-warning);
}
.btn-outline-warning:hover {
    background: var(--mavoo-warning);
    color: #fff;
    transform: translateY(-2px);
}

/* Danger */
.btn-danger {
    background: var(--mavoo-danger);
    border: none;
    color: #fff;
    box-shadow: 0 4px 12px rgba(var(--mavoo-danger-rgb), .30);
}
.btn-danger:hover {
    background: #DC2626;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(var(--mavoo-danger-rgb), .40);
    color: #fff;
}
.btn-outline-danger {
    background: transparent;
    color: var(--mavoo-danger);
    border: 1.5px solid var(--mavoo-danger);
}
.btn-outline-danger:hover {
    background: var(--mavoo-danger);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(var(--mavoo-danger-rgb), .30);
}

/* Info */
.btn-info {
    background: var(--mavoo-info);
    border: none;
    color: #fff;
    box-shadow: 0 4px 12px rgba(var(--mavoo-info-rgb), .30);
}
.btn-info:hover {
    background: #0284C7;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(var(--mavoo-info-rgb), .40);
    color: #fff;
}
.btn-outline-info {
    background: transparent;
    color: var(--mavoo-info);
    border: 1.5px solid var(--mavoo-info);
}
.btn-outline-info:hover {
    background: var(--mavoo-info);
    color: #fff;
    transform: translateY(-2px);
}

/* Light / Secondary */
.btn-light {
    background: var(--mavoo-white);
    color: var(--mavoo-ink-700);
    border: 1.5px solid var(--mavoo-ink-200);
}
.btn-light:hover {
    background: var(--mavoo-ink-50);
    border-color: var(--mavoo-ink-300);
    color: var(--mavoo-ink-900);
    transform: translateY(-1px);
}
.btn-secondary {
    background: var(--mavoo-ink-100);
    color: var(--mavoo-ink-700);
    border: 1.5px solid transparent;
}
.btn-secondary:hover {
    background: var(--mavoo-ink-200);
    color: var(--mavoo-ink-900);
}

/* Dark */
.btn-dark {
    background: var(--mavoo-ink-900);
    border: none;
    color: #fff;
}
.btn-dark:hover {
    background: #1E293B;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(15, 23, 42, .30);
    color: #fff;
}

/* Tamaños */
.btn-sm {
    padding: .38rem .8rem;
    font-size: .8rem;
    border-radius: 8px;
    gap: .35rem;
}
.btn-lg {
    padding: .8rem 1.5rem;
    font-size: 1rem;
    border-radius: 12px;
}
.btn-icon {
    width: 38px;
    height: 38px;
    padding: 0;
    flex-shrink: 0;
}
.btn-icon.btn-sm { width: 32px; height: 32px; }
.btn-icon.btn-lg { width: 46px; height: 46px; }

/* Block */
.btn-block,
.w-100.btn { width: 100%; }

/* Logout del header */
.btn-logout {
    padding: .42rem .95rem !important;
    font-size: .82rem !important;
    border-radius: 8px !important;
}

/* ============================================================
   BADGES — vivos y variados (no monocromáticos)
   ============================================================ */
.badge {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .35em .7em;
    font-size: .72rem;
    font-weight: 700;
    line-height: 1;
    border-radius: 999px;
    letter-spacing: .02em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: var(--mavoo-transition);
}
.badge i,
.badge svg { font-size: .85em; }

.badge.bg-primary,
.badge-primary {
    background: var(--mavoo-primary-50) !important;
    color: var(--mavoo-primary-700) !important;
    border-color: rgba(var(--mavoo-primary-rgb), .25);
}
.badge.bg-success,
.badge-success {
    background: var(--mavoo-success-soft) !important;
    color: #047857 !important;
    border-color: rgba(var(--mavoo-success-rgb), .25);
}
.badge.bg-warning,
.badge-warning {
    background: var(--mavoo-warning-soft) !important;
    color: #92400E !important;
    border-color: rgba(var(--mavoo-warning-rgb), .30);
}
.badge.bg-danger,
.badge-danger {
    background: var(--mavoo-danger-soft) !important;
    color: #B91C1C !important;
    border-color: rgba(var(--mavoo-danger-rgb), .25);
}
.badge.bg-info,
.badge-info {
    background: var(--mavoo-info-soft) !important;
    color: #0369A1 !important;
    border-color: rgba(var(--mavoo-info-rgb), .25);
}
.badge.bg-violet {
    background: var(--mavoo-violet-soft) !important;
    color: #6D28D9 !important;
    border-color: rgba(var(--mavoo-violet-rgb), .25);
}
.badge.bg-pink {
    background: var(--mavoo-pink-soft) !important;
    color: #BE185D !important;
    border-color: rgba(var(--mavoo-pink-rgb), .25);
}
.badge.bg-dark {
    background: var(--mavoo-ink-900) !important;
    color: #fff !important;
}
.badge.bg-light {
    background: var(--mavoo-white) !important;
    color: var(--mavoo-ink-700) !important;
    border-color: var(--mavoo-ink-200);
}

/* Badge "pulse" para notificaciones */
.badge-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    padding: 0;
    position: relative;
}
.badge-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: inherit;
    opacity: .35;
    animation: badgePulse 1.8s ease-out infinite;
}
@keyframes badgePulse {
    0%   { transform: scale(1);   opacity: .35; }
    100% { transform: scale(2.4); opacity: 0;   }
}

/* ============================================================
   ALERTS — coloridos con borde lateral de acento
   ============================================================ */
.alert {
    border: 1px solid transparent;
    border-radius: var(--mavoo-radius);
    padding: 1rem 1.15rem;
    margin-bottom: 1.15rem;
    font-size: .9rem;
    border-left-width: 4px;
    display: flex;
    align-items: flex-start;
    gap: .7rem;
}
.alert i,
.alert svg { font-size: 1.15rem; margin-top: .1rem; }
.alert-primary {
    background: var(--mavoo-primary-50);
    color: var(--mavoo-primary-700);
    border-color: rgba(var(--mavoo-primary-rgb), .20);
    border-left-color: var(--mavoo-primary);
}
.alert-success {
    background: var(--mavoo-success-soft);
    color: #065F46;
    border-color: rgba(var(--mavoo-success-rgb), .25);
    border-left-color: var(--mavoo-success);
}
.alert-warning {
    background: var(--mavoo-warning-soft);
    color: #92400E;
    border-color: rgba(var(--mavoo-warning-rgb), .30);
    border-left-color: var(--mavoo-warning);
}
.alert-danger {
    background: var(--mavoo-danger-soft);
    color: #991B1B;
    border-color: rgba(var(--mavoo-danger-rgb), .25);
    border-left-color: var(--mavoo-danger);
}
.alert-info {
    background: var(--mavoo-info-soft);
    color: #075985;
    border-color: rgba(var(--mavoo-info-rgb), .25);
    border-left-color: var(--mavoo-info);
}

/* ============================================================
   TABLES — limpias, con header tintado y hover sutil
   ============================================================ */
.table {
    --bs-table-color: var(--mavoo-ink-700);
    --bs-table-bg: transparent;
    --bs-table-border-color: var(--mavoo-ink-200);
    --bs-table-hover-bg: var(--mavoo-ink-50);
    --bs-table-hover-color: var(--mavoo-ink-900);
    margin-bottom: 0;
    font-size: .9rem;
    border-color: var(--mavoo-ink-200);
}
.table > thead {
    background: linear-gradient(180deg, var(--mavoo-ink-50) 0%, var(--mavoo-white) 100%);
}
.table > thead th {
    font-size: .74rem;
    font-weight: 700;
    color: var(--mavoo-ink-600);
    text-transform: uppercase;
    letter-spacing: .04em;
    padding: .85rem 1rem;
    border-bottom: 1.5px solid var(--mavoo-ink-200);
    white-space: nowrap;
    background: transparent;
}
.table > tbody td {
    padding: .85rem 1rem;
    border-bottom: 1px solid var(--mavoo-ink-100);
    color: var(--mavoo-ink-700);
    vertical-align: middle;
}
.table > tbody tr {
    transition: background .15s ease, transform .15s ease;
}
.table > tbody tr:hover {
    background: var(--mavoo-primary-50) !important;
}
.table > tbody tr:last-child td { border-bottom: 0; }

/* Table striped con tinte frío */
.table-striped > tbody > tr:nth-of-type(odd) > * {
    background: rgba(var(--mavoo-cyan-rgb), .025);
}

/* Table bordered */
.table-bordered {
    border: 1px solid var(--mavoo-ink-200);
    border-radius: var(--mavoo-radius);
    overflow: hidden;
}
.table-bordered > :not(caption) > * > * {
    border-color: var(--mavoo-ink-200);
}

/* ============================================================
   BREADCRUMB — re-styling del que usan las vistas
   ============================================================ */
.breadcrumb {
    background: var(--mavoo-ink-50) !important;
    border-radius: var(--mavoo-radius);
    padding: .75rem 1rem !important;
    margin: 0 0 1rem;
    border: 1px solid var(--mavoo-ink-200);
    font-size: .85rem;
}
.breadcrumb-item,
.breadcrumb-item a {
    color: var(--mavoo-ink-600);
