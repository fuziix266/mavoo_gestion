/* ============================================================
   MASTRO DESIGN SYSTEM — Mavoo Gestión
   Reemplazo de estilos para el <style> del layout compartido.
   - Paleta: azul/celeste ancla + acentos vivos (éxito, alerta, peligro,
     info, decorative warm, decorative violet).
   - Solo CSS, no requiere cambios en HTML de las ~45 vistas.
   - Respeta estructura .mavoo-* (no se cambia position/sticky/fixed).
   ============================================================ */

:root {
    /* —— Marca: ancla azul/celeste —— */
    --mavoo-primary:        #0066FF;
