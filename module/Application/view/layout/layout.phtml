    --mavoo-cyan:           #00D3D3;
    --mavoo-cyan-rgb:       0, 211, 211;
    --mavoo-cyan-soft:      #E0FAFA;
    --mavoo-gradient:       linear-gradient(135deg, #0066FF 0%, #00D3D3 100%);

    /* —— Acentos vivos (badges, charts, iconos, alertas) —— */
    --mavoo-success:        #10B981;
    --mavoo-success-rgb:    16, 185, 129;
