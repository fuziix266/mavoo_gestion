$base        = $this->basePath();
$identity    = $this->identity ?? null;
$roles       = $this->userRoles ?? [];
$perms       = $this->userPermissions ?? [];

$hasRole  = fn(string $role): bool => in_array($role, (array)$roles, true);
$permsList = is_array($perms) ? $perms : [];
$isAllowed = function (string $perm) use ($hasRole, $permsList): bool {
    return $hasRole('dios') || in_array($perm, $permsList, true);
};

$requestUri = $_SERVER['REQUEST_URI'] ?? '';

// Helper para detectar coincidencia flexible de URL en el menú
if (!function_exists('layoutIsActive')) {
    function layoutIsActive(string $needle, string $requestUri): bool {
        if ($needle === '#' || $needle === '') return false;
        $n = basename(parse_url($needle, PHP_URL_PATH) ?? '');
        $u = basename(parse_url($requestUri, PHP_URL_PATH) ?? '');
        return $n !== '' && $n === $u;
    }
}

$currentPath = basename(parse_url($requestUri, PHP_URL_PATH) ?? '');
