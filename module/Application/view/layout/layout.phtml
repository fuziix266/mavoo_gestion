    --mavoo-danger:         #EF4444;
    --mavoo-danger-rgb:     239, 68, 68;
    --mavoo-danger-soft:    #FEE2E2;
    --mavoo-info:           #0EA5E9;
    --mavoo-info-rgb:       14, 165, 233;
    --mavoo-info-soft:      #E0F2FE;
    --mavoo-violet:         #8B5CF6;
    --mavoo-violet-rgb:     139, 92, 246;
    --mavoo-violet-soft:    #EDE9FE;
    --mavoo-pink:           #EC4899;
    --mavoo-pink-rgb:       236, 72, 153;
    --mavoo-pink-soft:      #FCE7F3;

    /* —— Neutros —— */
    --mavoo-ink-900:        #0F172A;
    --mavoo-ink-700:        #334155;
    --mavoo-ink-600:        #475569;
    --mavoo-ink-500:        #64748B;
    --mavoo-ink-400:        #94A3B8;
    --mavoo-ink-300:        #CBD5E1;
    --mavoo-ink-200:        #E2E8F0;
    --mavoo-ink-100:        #F1F5F9;
    --mavoo-ink-50:         #F8FAFC;
