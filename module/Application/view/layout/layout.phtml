<script>
(function () {
    'use strict';

    // =================== Loader ===================
    window.cargando = function () {
        document.getElementById('global-loader')?.classList.add('show');
    };
    window.cerrarCargando = function () {
        document.getElementById('global-loader')?.classList.remove('show');
    };
    setTimeout(cerrarCargando, 1500);

    // =================== Loader en submit ===================
    document.addEventListener('submit', function (e) {
        if (e.target.tagName === 'FORM') cargando();
    });

    // =================== Menú: dropdowns ===================
    (function () {
        var navList = document.getElementById('mavooMainNav');
        if (!navList) return;

        function positionSubmenu(toggle, sub) {
            // Calcula la posición absoluta del toggle en viewport
            var r = toggle.getBoundingClientRect();
            // El nav tiene altura ~56px (var --mavoo-sidebar-h) + 60px header = 116
            var top = r.bottom + 4;
            var left = r.left;
            // Asegurar que no se salga del viewport a la derecha
            var subWidth = 230;
            if (left + subWidth > window.innerWidth) {
                left = window.innerWidth - subWidth - 8;
            }
            sub.style.top = top + 'px';
            sub.style.left = left + 'px';
        }

        function closeAllExcept(target) {
            navList.querySelectorAll('a[data-mavoo-toggle="submenu"]').forEach(function (toggle) {
                if (toggle.dataset.target !== target) {
                    var id = toggle.dataset.target.replace('#', '');
                    var sub = document.getElementById(id);
                    if (sub && sub.classList.contains('show')) {
                        sub.classList.remove('show');
                        sub.style.top = '';
                        sub.style.left = '';
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                }
            });
        }

        navList.querySelectorAll('a[data-mavoo-toggle="submenu"]').forEach(function (toggle) {
            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var targetId = toggle.dataset.target.replace('#', '');
                var sub = document.getElementById(targetId);
                if (!sub) return;

                var willOpen = !sub.classList.contains('show');
                closeAllExcept(toggle.dataset.target);
                if (willOpen) {
                    positionSubmenu(toggle, sub);
                    sub.classList.add('show');
                    toggle.setAttribute('aria-expanded', 'true');
                } else {
                    sub.classList.remove('show');
                    sub.style.top = '';
                    sub.style.left = '';
                    toggle.setAttribute('aria-expanded', 'false');
                }
            });
        });

        // Cerrar submenús al click fuera del nav
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.mavoo-nav')) {
                closeAllExcept(null);
            }
        });

        // Esc para cerrar
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeAllExcept(null);
        });
    })();

    // =================== Active link al cargar ===================
    (function () {
        var current = window.location.pathname.replace(/\/$/, '');
        document.querySelectorAll('.mavoo-nav .main-nav a[href]').forEach(function (a) {
            try {
                var href = new URL(a.getAttribute('href'), window.location.origin).pathname.replace(/\/$/, '');
                if (href && href !== '#' && href === current) {
                    var li = a.closest('li');
                    if (li) li.classList.add('active');
                }
            } catch (e) {}
        });
    })();

    // =================== Limpiar backdrop de modales duplicados ===================
    document.addEventListener('shown.bs.modal', function () {
        setTimeout(function () {
            var backdrops = document.querySelectorAll('.modal-backdrop');
            if (backdrops.length > 1) {
                for (var i = 0; i < backdrops.length - 1; i++) backdrops[i].remove();
            }
        }, 100);
    });
})();
</script>

</body>
</html>