}
.modal-header {
    background: var(--mavoo-gradient);
    color: #fff;
    border-bottom: none;
    padding: 1.1rem 1.5rem;
}
.modal-header .modal-title {
    font-weight: 700;
    color: #fff;
    letter-spacing: -.01em;
}
.modal-header .btn-close {
    filter: invert(1) brightness(2);
    opacity: .85;
}
.modal-header .btn-close:hover { opacity: 1; transform: rotate(90deg); transition: transform .3s; }
.modal-body { padding: 1.5rem; }
.modal-footer {
    background: var(--mavoo-ink-50);
    border-top: 1px solid var(--mavoo-ink-200);
    padding: 1rem 1.5rem;
    gap: .5rem;
}

/* ============================================================
   LIST GROUP — más limpio, item activo con gradiente
   ============================================================ */
.list-group {
    border-radius: var(--mavoo-radius);
    overflow: hidden;
    border: 1px solid var(--mavoo-ink-200);
}
.list-group-item {
    border-color: var(--mavoo-ink-200);
    padding: .8rem 1.1rem;
    color: var(--mavoo-ink-700);
    transition: var(--mavoo-transition);
