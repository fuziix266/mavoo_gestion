(function () {
    'use strict';
    if (typeof Chart === 'undefined') {
        console.error('Chart.js no se ha cargado');
        return;
    }

    var charts = {};
    var moneda = <?= json_encode($moneda) ?>;
    var dataUrl = <?= json_encode($this->url('mod.arriendo.dashboard.data')) ?>;
    var exportUrl = <?= json_encode($this->url('mod.arriendo.dashboard.export')) ?>;

    function fmt(value) {
        try { return new Intl.NumberFormat('es-CL', { maximumFractionDigits: 0 }).format(value || 0); }
        catch (e) { return String(value || 0); }
    }

    function applyStats(resumen) {
        resumen = resumen || {};
        document.getElementById('stat-hoy').textContent    = moneda + ' ' + fmt(resumen.ingresos_hoy);
        document.getElementById('stat-semana').textContent = moneda + ' ' + fmt(resumen.ingresos_semana);
        document.getElementById('stat-mes').textContent    = moneda + ' ' + fmt(resumen.ingresos_mes);
        document.getElementById('stat-anio').textContent   = moneda + ' ' + fmt(resumen.ingresos_anio);
    }

    function applyCharts(graficos) {
        graficos = graficos || {};
        Object.values(charts).forEach(function (c) { try { c.destroy(); } catch (e) {} });
        charts = {};

        // Días
        var dias = graficos.ingresos_por_dia || [];
        var ctxDias = document.getElementById('chart-dias').getContext('2d');
        charts.dias = new Chart(ctxDias, {
            type: 'line',
            data: {
                labels: dias.map(function (d) { return d.fecha; }),
                datasets: [{
                    label: 'Ingresos',
                    data: dias.map(function (d) { return d.total; }),
                    borderColor: '#4F46E5',
                    backgroundColor: 'rgba(79,70,229,.1)',
                    tension: .4, fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return moneda + ' ' + fmt(v); } } } }
            }
        });

        // Métodos
        var metodos = graficos.ingresos_por_metodo || {};
        var ctxMetodos = document.getElementById('chart-metodos').getContext('2d');
        charts.metodos = new Chart(ctxMetodos, {
            type: 'doughnut',
            data: {
                labels: Object.keys(metodos),
                datasets: [{ data: Object.values(metodos), backgroundColor: ['#10B981','#F59E0B','#EF4444','#3B82F6'] }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });

        // Canchas
        var canchas = graficos.ingresos_por_cancha || [];
        var ctxCan = document.getElementById('chart-canchas').getContext('2d');
        charts.canchas = new Chart(ctxCan, {
            type: 'bar',
            data: {
                labels: canchas.map(function (c) { return c.cancha; }),
                datasets: [{ label: 'Ingresos', data: canchas.map(function (c) { return c.total; }), backgroundColor: '#4F46E5' }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return moneda + ' ' + fmt(v); } } } } }
        });

        // Extras
        var extras = graficos.top_extras || [];
        var ctxEx = document.getElementById('chart-extras').getContext('2d');
        charts.extras = new Chart(ctxEx, {
            type: 'bar',
            data: {
                labels: extras.map(function (e) { return e.nombre; }),
                datasets: [{ label: 'Cantidad', data: extras.map(function (e) { return e.cantidad; }), backgroundColor: '#10B981' }]
            },
            options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } } }
        });

        // Horarios
        var horarios = graficos.horarios_rentables || [];
        var ctxHr = document.getElementById('chart-horarios').getContext('2d');
        charts.horarios = new Chart(ctxHr, {
            type: 'bar',
            data: {
                labels: horarios.map(function (h) { return h.horario; }),
                datasets: [{ label: 'Ingresos', data: horarios.map(function (h) { return h.total; }), backgroundColor: '#F59E0B' }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return moneda + ' ' + fmt(v); } } } } }
        });
    }

    function applyTable(list) {
        list = list || [];
        var tbody = document.getElementById('transactions-body');
        var totalEl = document.getElementById('total-transacciones');
        totalEl.textContent = list.length + ' registros';
        if (!list.length) {
            tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 1.5rem; color: #6B7280;">No hay transacciones en el período seleccionado</td></tr>';
            return;
        }
        tbody.innerHTML = list.map(function (t) {
            var fecha  = t.fecha  || '';
            var hora   = t.hora   || '';
            var cancha = t.cancha || '';
            var cliente = t.cliente || '';
            var total = fmt(t.total);
            var metodo = t.metodo || '';
            var badge = t.pagado
                ? '<span class="badge badge-success">Pagado</span>'
                : '<span class="badge badge-warning">Pendiente</span>';
            var split = (t.split && t.split > 1) ? (t.split + ' personas') : '-';
            return '<tr>' +
                '<td>' + fecha + '</td>' +
                '<td>' + hora  + '</td>' +
                '<td>' + cancha + '</td>' +
                '<td>' + cliente + '</td>' +
                '<td style="font-weight:600;">' + moneda + ' ' + total + '</td>' +
                '<td>' + metodo + '</td>' +
                '<td>' + badge + '</td>' +
                '<td>' + split + '</td>' +
                '</tr>';
        }).join('');
    }

    function loadDashboardData() {
        var startDate = document.getElementById('start-date').value;
        var endDate   = document.getElementById('end-date').value;
        var canchaId  = document.getElementById('filter-cancha').value;
        var metodo    = document.getElementById('filter-metodo').value;
        var qs = new URLSearchParams();
        if (startDate) qs.set('start_date', startDate);
        if (endDate)   qs.set('end_date', endDate);
        if (canchaId)  qs.set('cancha_id', canchaId);
        if (metodo)    qs.set('metodo_pago', metodo);

        fetch(dataUrl + '?' + qs.toString(), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : { resumen:{}, graficos:{ingresos_por_metodo:{}}, transacciones:[] }; })
            .then(function (data) {
                applyStats(data.resumen || {});
                applyCharts(data.graficos || {});
                applyTable(data.transacciones || []);
            })
            .catch(function (err) { console.error('Error dashboard:', err); });
    }

    window.applyFilters = function () { loadDashboardData(); };

    window.exportData = function () {
        var startDate = document.getElementById('start-date').value;
        var endDate   = document.getElementById('end-date').value;
        var qs = new URLSearchParams();
        if (startDate) qs.set('start_date', startDate);
        if (endDate)   qs.set('end_date', endDate);
        window.location.href = exportUrl + '?' + qs.toString();
    };

    document.addEventListener('DOMContentLoaded', loadDashboardData);
})();
<?php $this->inlineScript()->captureEnd(); ?>

<?php $this->inlineScript()->appendFile('https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js'); ?>
