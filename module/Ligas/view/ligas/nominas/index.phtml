            <div class="input-group mb-2" data-index="${index}">
                <input type="text" class="form-control" value="${opcion}" readonly>
                <span class="input-group-text badge marca-toggle text-outline-${estilo[index]}"><?= __('deporte_padel.ejemplo') ?></span>
