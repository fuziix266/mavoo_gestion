$(document).on('click', '.btn-editar-restricciones', function () {
    const nominaUuid = $(this).data('nomina-uuid');
    const userUuid = $(this).data('user-uuid');
    $('#restriccionesUserUuid').val(userUuid);
    $('#restriccionesNominaUuid').val(nominaUuid);
    $.get('<?= $this->url('ligas.nominas.obt_rstr', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>', {
        nomina_uuid: nominaUuid, user_uuid: userUuid
    }, function (response) {
        const total = response.restricciones.length;
        const porColumna = Math.ceil(total / 3);
        let html = '<div class="row">';
        for (let i = 0; i < 3; i++) {
            html += '<div class="col">';
            const inicio = i * porColumna;
            const fin = Math.min(inicio + porColumna, total);
            for (let j = inicio; j < fin; j++) {
                const r = response.restricciones[j];
                const checked = response.seleccionadas.includes(r.id) ? 'checked' : '';
                html += `
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox" value="${r.id}" id="restriccion-${r.id}" ${checked}>
                        <label class="form-check-label" for="restriccion-${r.id}">${r.hora_inicio}</label>
                    </div>
                `;
            }
            html += '</div>';
        }
        html += '</div>';
        $('#listaRestricciones').html(html);
    });
});
