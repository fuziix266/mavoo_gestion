<script>
	
$('#formRegistrarJugador').on('submit', function (e) {
    e.preventDefault();
    const formData = {
        nombre: $('#nuevoNombreJugador').val(),
        pais_uuid: $('#paisUuidJugador').val(),
        documento: $('#documentoJugador').val(),
        telefono: $('#nuevoTelefonoJugador').val(),
        email: $('#nuevoEmailJugador').val(),
        nacimiento: $('#nacimientoJugador').val(),
        genero: $('input[name="generoJugador"]:checked').val(),
        _token: '<?= csrf_token() ?>'
    };

    if (!formData.nombre || !formData.pais_uuid || !formData.email || !formData.nacimiento || !formData.genero) {
        alert('<?= __('deporte_padel.campos_obligatorios') ?>');
        return;
    }

    $.ajax({
        url: '<?= $this->url('ligas.nominas.verificar-jugador', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>',
        method: 'POST',
        data: formData,
        success: function (response) {
            if (response.success) {
                agregarJugador(formData);
            } else if (response.tipo === 'identificacion' || response.tipo === 'email') {
                const msg = `${response.mensaje}\nNombre: ${response.detalles.nombre}\nEmail: ${response.detalles.email}`;
                alert(msg);
                // Reabre modal para reintento (limpia campos opcionales si necesario)
                $('#modalRegistrarJugador').modal('show');
            } else if (response.tipo === 'confirmacion') {
                let html = `<strong>${response.mensaje}</strong><ul>`;
                response.matches.forEach(match => {
                    html += `<li>Nombre: ${match.nombre} | Email: ${match.email}</li>`;
                });
                html += `</ul><button id="confirmarAgregar" class="btn btn-secondary mt-2">Agregar nuevo usuario de todos modos</button>`;
                $('#alertasMatches').html(html).removeClass('d-none');
                $('#confirmarAgregar').on('click', function () {
                    agregarJugador(formData);
                });
            }
        },
        error: function (xhr) {
            const errorMessage = xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : '<?= __('deporte_padel.error_general') ?>';
            alert(errorMessage);
        }
    });
});

function agregarJugador(formData) {
    $.ajax({
        url: '<?= $this->url('ligas.nominas.agregar-jugador', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>',
        method: 'POST',
        data: formData,
        success: function (response) {
            if (response.success) {
                $('#modalRegistrarJugador').modal('hide');
                location.reload();
            }
        },
        error: function (xhr) {
            const errorMessage = xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : '<?= __('deporte_padel.error_agregar') ?>';
            alert(errorMessage);
            cerrarCargando();
        }
    });
}
	
function escapeHtml(str) {
    return str.replace(/'/g, "\\'").replace(/"/g, '\\"');
}

function abrirEditarMarcaDesdeBoton(btn) {
    const marcaData = JSON.parse(btn.getAttribute('data-marca'));
    abrirEditarMarca(
        marcaData.uuid,
        marcaData.titulo,
        marcaData.opciones,
        marcaData.estilo,
        marcaData.elegido,
        marcaData.formulario,
        marcaData.obligatorio
    );
}

function cargarMarcas() {
    fetch('<?= $this->url('ligas.nominas.marcas-listar', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>')
        .then(response => response.json())
        .then(data => {
            const tbody = document.getElementById('marcas-data');
            tbody.innerHTML = '';
            data.marcas.forEach(marca => {
                const isActive = Array.isArray(data.marcas_activas) ? data.marcas_activas.includes(marca.uuid) : Object.values(data.marcas_activas).includes(marca.uuid);
                // Limpiar espacios en opciones
                const opcionesLimpias = marca.marca.opciones.map(op => op.trim());
                const marcaData = {
                    uuid: marca.uuid,
                    titulo: marca.marca.Titulo,
                    opciones: opcionesLimpias,
                    estilo: marca.marca.estilo,
                    elegido: marca.marca.elegido ?? null,
                    formulario: marca.formulario,
                    obligatorio: marca.obligatorio
                };
                tbody.innerHTML += `
                    <tr>
                        <td>${marca.marca.Titulo}</td>
                        <td>${opcionesLimpias.join(', ')}</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" ${isActive ? 'checked' : ''} onchange="toggleMarca('${marca.uuid}')">
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-primary" data-marca='${JSON.stringify(marcaData).replace(/'/g, "\\'")}' onclick="abrirEditarMarcaDesdeBoton(this)"><?= __('deporte_padel.editar') ?></button>
                            <button class="btn btn-sm btn-danger" onclick="confirmEliminarMarca('${marca.uuid}')"><?= __('deporte_padel.eliminar') ?></button>
                        </td>
                    </tr>`;
            });
            const opcionesTbody = document.getElementById('opciones-avanzadas-data');
            opcionesTbody.innerHTML = '';
            data.marcas.forEach(marca => {
                const isActive = Array.isArray(data.marcas_activas) ? data.marcas_activas.includes(marca.uuid) : Object.values(data.marcas_activas).includes(marca.uuid);
                if (isActive) {
                    opcionesTbody.innerHTML += `
                        <tr>
                            <td>${marca.marca.Titulo}</td>
                            <td>
                                <button class="btn btn-sm btn-warning" onclick="confirmResetMarca('${marca.uuid}')"><?= __('deporte_padel.reset') ?></button>
                                <button class="btn btn-sm btn-success" onclick="confirmAplicarMarca('${marca.uuid}')"><?= __('deporte_padel.aplicar') ?></button>
                            </td>
                        </tr>`;
                }
            });
        });
}

function toggleMarca(uuid) {
    if (confirm('<?= __('deporte_padel.confirmar_cambio_estado') ?>')) {
        fetch('<?= url("mod/padel/gestion/nominas/marcas/toggle") ?>/' + uuid, { method: 'POST', headers: { 'X-CSRF-TOKEN': '<?= csrf_token() ?>' } })
            .then(response => response.json())
            .then(data => { cargarMarcas(); });
    }
}

function confirmResetMarca(uuid) {
    if (confirm('<?= __('deporte_padel.confirmar_reset_marca') ?>')) {
        fetch('<?= url("mod/padel/gestion/nominas/marcas/reset") ?>/' + uuid, { method: 'POST', headers: { 'X-CSRF-TOKEN': '<?= csrf_token() ?>' } })
            .then(response => response.json())
            .then(data => { alert(data.success); window.location.reload(); });
    }
}

function confirmAplicarMarca(uuid) {
    if (confirm('<?= __('deporte_padel.confirmar_aplicar_marca') ?>')) {
        fetch('<?= url("mod/padel/gestion/nominas/marcas/aplicar") ?>/' + uuid, { method: 'POST', headers: { 'X-CSRF-TOKEN': '<?= csrf_token() ?>' } })
            .then(response => response.json())
            .then(data => { alert(data.success); window.location.reload(); });
    }
}

function confirmEliminarMarca(uuid) {
    if (confirm('<?= __('deporte_padel.confirmar_eliminar_marca') ?>')) {
        fetch('<?= url("mod/padel/gestion/nominas/marcas/eliminar") ?>/' + uuid, { method: 'POST', headers: { 'X-CSRF-TOKEN': '<?= csrf_token() ?>' } })
            .then(response => response.json())
            .then(data => { cargarMarcas(); });
    }
}

function confirmResetGeneral(uuid) {
    if (confirm('<?= __('deporte_padel.confirmar_reset_general') ?>')) {
        fetch('<?= url("mod/padel/gestion/nominas/marcas/reset-general") ?>/' + uuid, { method: 'POST', headers: { 'X-CSRF-TOKEN': '<?= csrf_token() ?>' } })
