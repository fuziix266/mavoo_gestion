function agregarOpcion(tipo) {
    const input = document.getElementById(`nueva-opcion-${tipo}`);
    const select = document.getElementById(`nuevo-estilo-${tipo}`);
    const lista = document.getElementById(`opciones-lista-${tipo}`);
    const opcion = input.value.trim();
    const estilo = select.value;
    if (opcion) {
        const index = lista.children.length;
        lista.innerHTML += `
            <div class="input-group mb-2" data-index="${index}">
                <input type="text" class="form-control" value="${opcion}" readonly>
                <span class="input-group-text badge marca-toggle text-outline-${estilo}"><?= __('deporte_padel.ejemplo') ?></span>
                <select class="form-select" onchange="actualizarBadge(this, '${tipo}')">
                    <option value="success" ${estilo === 'success' ? 'selected' : ''}>Success <span class="badge marca-toggle text-outline-success"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="secondary" ${estilo === 'secondary' ? 'selected' : ''}>Secondary <span class="badge marca-toggle text-outline-secondary"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="primary" ${estilo === 'primary' ? 'selected' : ''}>Primary <span class="badge marca-toggle text-outline-primary"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="danger" ${estilo === 'danger' ? 'selected' : ''}>Danger <span class="badge marca-toggle text-outline-danger"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="warning" ${estilo === 'warning' ? 'selected' : ''}>Warning <span class="badge marca-toggle text-outline-warning"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="info" ${estilo === 'info' ? 'selected' : ''}>Info <span class="badge marca-toggle text-outline-info"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="light" ${estilo === 'light' ? 'selected' : ''}>Light <span class="badge marca-toggle text-outline-light"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="dark" ${estilo === 'dark' ? 'selected' : ''}>Dark <span class="badge marca-toggle text-outline-dark"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="link" ${estilo === 'link' ? 'selected' : ''}>Link <span class="badge marca-toggle text-outline-link"><?= __('deporte_padel.ejemplo') ?></span></option>
                </select>
                <div class="input-group-text">
                    <input type="checkbox" class="form-check-input mt-0" name="elegido-${tipo}" value="${index}" onchange="actualizarElegido('${tipo}')">
                    <label class="form-check-label ms-2"><?= __('deporte_padel.defecto') ?></label>
                </div>
                <button type="button" class="btn btn-outline-danger" onclick="eliminarOpcion(this, '${tipo}')">Eliminar</button>
            </div>`;
        input.value = '';
        select.value = 'success';
        actualizarElegido(tipo);
    }
}

function eliminarOpcion(btn, tipo) {
    btn.parentElement.remove();
    actualizarElegido(tipo);
}

function actualizarBadge(select, tipo) {
    const badge = select.parentElement.querySelector('.badge');
    const estilo = select.value;
    badge.className = `input-group-text badge marca-toggle text-outline-${estilo}`;
    badge.innerText = '<?= __('deporte_padel.ejemplo') ?>';
}

function actualizarElegido(tipo) {
    const checkboxes = document.querySelectorAll(`#opciones-lista-${tipo} input[name="elegido-${tipo}"]`);
    checkboxes.forEach((cb, index) => {
        cb.value = index;
        if (cb.checked) {
            checkboxes.forEach(other => {
                if (other !== cb) other.checked = false;
            });
        }
    });
}

