                    <option value="primary" ${estilo[index] === 'primary' ? 'selected' : ''}>Primary <span class="badge marca-toggle text-outline-primary"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="danger" ${estilo[index] === 'danger' ? 'selected' : ''}>Danger <span class="badge marca-toggle text-outline-danger"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="warning" ${estilo[index] === 'warning' ? 'selected' : ''}>Warning <span class="badge marca-toggle text-outline-warning"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="info" ${estilo[index] === 'info' ? 'selected' : ''}>Info <span class="badge marca-toggle text-outline-info"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="light" ${estilo[index] === 'light' ? 'selected' : ''}>Light <span class="badge marca-toggle text-outline-light"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="dark" ${estilo[index] === 'dark' ? 'selected' : ''}>Dark <span class="badge marca-toggle text-outline-dark"><?= __('deporte_padel.ejemplo') ?></span></option>
                    <option value="link" ${estilo[index] === 'link' ? 'selected' : ''}>Link <span class="badge marca-toggle text-outline-link"><?= __('deporte_padel.ejemplo') ?></span></option>
                </select>
                <div class="input-group-text">
                    <input type="checkbox" class="form-check-input mt-0" name="elegido-editar" value="${index}" ${elegido === index ? 'checked' : ''} onchange="actualizarElegido('editar')">
                    <label class="form-check-label ms-2"><?= __('deporte_padel.defecto') ?></label>
                </div>
                <button type="button" class="btn btn-outline-danger" onclick="eliminarOpcion(this, 'editar')">Eliminar</button>
            </div>`;
    });
    new bootstrap.Modal(document.getElementById('editarMarcaModal')).show();
}

document.getElementById('formAgregarMarca').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const opcionesLista = document.getElementById('opciones-lista-agregar').children;
    const opciones = [];
    const estilo = [];
    let elegido = null;
    for (let i = 0; i < opcionesLista.length; i++) {
        const input = opcionesLista[i].querySelector('input[type="text"]').value;
        const select = opcionesLista[i].querySelector('select').value;
        const checkbox = opcionesLista[i].querySelector('input[type="checkbox"]');
        opciones.push(input);
        estilo.push(select);
        if (checkbox.checked) elegido = i;
    }
    if (!formData.get('titulo')) {
        alert('<?= __('deporte_padel.titulo_requerido') ?>');
        return;
    }
    if (opciones.length === 0) {
        alert('<?= __('deporte_padel.opciones_requeridas') ?>');
        return;
    }
    const data = {
        evento_uuid: formData.get('evento_uuid'),
        opciones: opciones,
        estilo: estilo,
        elegido: elegido,
        titulo: formData.get('titulo'),
        formulario: formData.get('formulario') === 'on',
        obligatorio: formData.get('obligatorio') === 'on',
    };
    fetch('<?= $this->url('ligas.nominas.marcas-guardar', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': '<?= csrf_token() ?>' },
        body: JSON.stringify(data)
    })
        .then(response => response.json())
        .then(data => {
            alert(data.success);
            document.getElementById('agregarMarcaModal').querySelector('.btn-close').click();
            window.location.reload();
        });
});

document.getElementById('formEditarMarca').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const opcionesLista = document.getElementById('opciones-lista-editar').children;
    const opciones = [];
    const estilo = [];
    let elegido = null;
    for (let i = 0; i < opcionesLista.length; i++) {
        const input = opcionesLista[i].querySelector('input[type="text"]').value;
        const select = opcionesLista[i].querySelector('select').value;
        const checkbox = opcionesLista[i].querySelector('input[type="checkbox"]');
        opciones.push(input);
        estilo.push(select);
        if (checkbox.checked) elegido = i;
    }
    if (!formData.get('titulo')) {
        alert('<?= __('deporte_padel.titulo_requerido') ?>');
        return;
    }
    if (opciones.length === 0) {
        alert('<?= __('deporte_padel.opciones_requeridas') ?>');
        return;
    }
    const data = {
        opciones: opciones,
        estilo: estilo,
        elegido: elegido,
        titulo: formData.get('titulo'),
        formulario: formData.get('formulario') === 'on',
        obligatorio: formData.get('obligatorio') === 'on',
    };
    fetch('<?= url("mod/padel/gestion/nominas/marcas/editar") ?>/' + formData.get('uuid'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': '<?= csrf_token() ?>' },
        body: JSON.stringify(data)
    })
        .then(response => response.json())
        .then(data => {
            document.getElementById('editarMarcaModal').querySelector('.btn-close').click();
            cargarMarcas();
        });
});

document.addEventListener('DOMContentLoaded', cargarMarcas);
</script>

