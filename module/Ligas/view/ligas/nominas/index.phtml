    e.preventDefault();
    const seleccionadas = [];
    const nominaUuid = $('#restriccionesNominaUuid').val();
    $('#listaRestricciones input:checked').each(function () { seleccionadas.push($(this).val()); });
    $.post('<?= $this->url('ligas.nominas.g_rstr', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>', {
        nomina_uuid: $('#restriccionesNominaUuid').val(), user_uuid: $('#restriccionesUserUuid').val(),
