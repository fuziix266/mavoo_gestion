let nominaOrigenId = null;
$(document).on('click', '.btn-reordenar', function () {
    nominaOrigenId = $(this).data('nomina-id');
    $('.btn-reordenar').each(function () {
        $(this).html('<i class="ti ti-arrows-vertical text-secondary" style="font-size: 20px;"></i>');
        $(this).prop('disabled', false);
        $(this).removeClass('btn-reordenar-destino').addClass('btn-reordenar');
    });
    $('.btn-reordenar').each(function () {
        const posibleDestinoId = $(this).data('nomina-id');
        if (posibleDestinoId !== nominaOrigenId) {
            $(this).html('<i class="ti ti-arrows-diff text-success" style="font-size: 20px;"></i>');
            $(this).removeClass('btn-reordenar').addClass('btn-reordenar-destino');
        } else {
            $(this).prop('disabled', true);
        }
    });
});
$(document).on('click', '.btn-reordenar-destino', function () {
    const nominaDestinoId = $(this).data('nomina-id');
    if (nominaOrigenId === nominaDestinoId) {
        console.warn('No se puede mover sobre sí mismo.');
        return;
    }
    $.ajax({
        url: '<?= $this->url('ligas.nominas.mover', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>', method: 'POST',
        data: { origen_id: nominaOrigenId, destino_id: nominaDestinoId, _token: '<?= csrf_token() ?>' },
        success: function () { location.reload(); },
        error: function () { alert('<?= __('deporte_padel.error_reordenar_nomina') ?>'); }
    });
});
$('#modalInscribirUsuarios').on('shown.bs.modal', function (event) {
    const button = $(event.relatedTarget);
    const categoriaUuid = button.data('categoria-uuid');
    const nominaUuid = button.data('nomina-uuid');
    const usuarios = button.data('usuarios') || [];

    // Setear valores en los inputs hidden
    $('#campoCategoriaUuid').val(categoriaUuid);
    $('#campoNominaUuid').val(nominaUuid);

    // Cambiar la acción del formulario según si es agregar o editar
    const form = $('#formInscribirUsuarios');
    const url = nominaUuid ? '<?= $this->url('ligas.nominas.editar', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>' : '<?= $this->url('ligas.nominas.inscribir', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>';
    form.attr('action', url);

    // Limpiar y reinicializar Select2
    $('.select2-ajax').each(function () {
        $(this).val(null).trigger('change');
        $(this).select2('destroy');
    });

    // Prellenar selects para editar
    if (nominaUuid && usuarios.length > 0) {
        usuarios.forEach((usuario, index) => {
            const select = $(`#usuario_id_${index + 1}`);
            const option = new Option(usuario.text, usuario.id, true, true);
            select.append(option).trigger('change');
        });
    }

    // Inicializar Select2
    $('.select2-ajax').select2({
        dropdownParent: $('#modalInscribirUsuarios'),
        placeholder: '<?= __("dios.js1") ?>',
        minimumInputLength: 2,
        ajax: {
            url: '<?= $this->url('ligas.nominas.buscar_usuario', ['deporte' => $deporte ?? 'padel', 'uuid' => $evento['uuid'] ?? 'fake-uuid']) ?>',
            dataType: 'json',
            delay: 250,
            data: function (params) {
            		const categoriaUuid = button.data('categoria-uuid');
                return { q: params.term, page: params.page || 1, mod_gestion_categoria_uuid: categoriaUuid };
            },
            processResults: function (data, params) {
                params.page = params.page || 1;
                return { results: data.results, pagination: { more: data.more } };
            },
            cache: true
        },
        language: {
            inputTooShort: function () { return "<?= __('dios.js2') ?>"; },
            searching: function () { return "<?= __('dios.js3') ?>"; },
            noResults: function () { return "<?= __('dios.js4') ?>"; },
            loadingMore: function () { return "<?= __('dios.js5') ?>"; }
        }
    });
});

</script>
