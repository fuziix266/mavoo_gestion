<script>
const URL_ELIMINAR = "<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'eliminar-categoria', 'uuid' => 'UUID_PLACEHOLDER']) ?>";

document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.btn-eliminar-categoria[data-categoria-uuid]').forEach(boton => {
        boton.addEventListener('click', function () {
            const uuid = this.getAttribute('data-categoria-uuid');
            if (confirm('<?= __('deporte_padel.seguro_eliminar_categoria') ?>')) {
                fetch(URL_ELIMINAR.replace('UUID_PLACEHOLDER', uuid), {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': 'csrf_disabled'
                    },
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('<?= __('deporte_padel.error_procesar_solicitud') ?>');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('<?= __('deporte_padel.error_procesar_solicitud') ?>');
                });
            }
        });
    });
});
function cargarCategoriasDisponibles() {
    fetch("<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'disponibles', 'uuid' => ($evento['uuid'] ?? '')]) ?>")
        .then(res => res.json())
        .then(data => {
            const container = document.getElementById('contenedorCategoriasDisponibles');
            container.innerHTML = '';
            data.forEach(cat => {
                container.innerHTML += `
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" value="${cat.id}" id="cat${cat.id}">
                        <label class="form-check-label" for="cat${cat.id}">
                            ${cat.titulo} - ${cat.subtitulo}
                        </label>
                    </div>
                `;
            });
            container.innerHTML += '<button type="button" class="btn btn-primary" onclick="agregarSeleccionadas()">Agregar Seleccionadas</button>';
        });
}
function agregarSeleccionadas() {
    const seleccionados = Array.from(document.querySelectorAll('#contenedorCategoriasDisponibles input:checked')).map(input => input.value);
    if (seleccionados.length === 0) return;
    if (confirm('¿Agregar estas categorías?')) {
        seleccionados.forEach(id => {
            fetch("<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'agregar-acceso', 'uuid' => ($evento['uuid'] ?? '')]) ?>", {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'X-CSRF-TOKEN': 'csrf'},
                body: JSON.stringify({categoria_lista_id: id})
            }).then(() => location.reload());
        });
    }
}
function eliminarAcceso(id) {
    if (confirm('¿Eliminar esta categoría?')) {
        let baseUrl = "<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'eliminar-acceso', 'uuid' => ($evento['uuid'] ?? '')]) ?>";
        fetch(baseUrl + '/' + id, {
            method: 'DELETE',
            headers: {'X-CSRF-TOKEN': 'csrf'}
        }).then(() => location.reload());
    }
}
function abrirModalEdicion(id, limite, a_considerar) {
    let baseUpdate = "<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'actcat', 'uuid' => '0']) ?>".replace('/0', '/' + id);
    document.getElementById('formEditarCategoria').action = baseUpdate;
    document.getElementById('categoria_id_modal').value = id;
    document.getElementById('limite_modal').value = limite;
    document.getElementById('a_considerar_modal').value = a_considerar;
}
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.color-input').forEach(function(input) {
        input.addEventListener('change', function () {
            const color = this.value;
            const id = this.dataset.id;
            let baseUrl = "<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'updateColor', 'uuid' => '0']) ?>".replace('/0', '/' + id);
            fetch(baseUrl, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': 'csrf'
                },
                body: JSON.stringify({ color })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    this.style.borderColor = data.color;
                }
            });
        });
    });
    
    // Lógica para actualizar el valor dinámico al cambiar el selector
    const select = document.getElementById('clasificadosSelect');
    if (select) {
        select.addEventListener('change', function() {
            const selectedValue = parseInt(this.value);
            // Actualizar el valor oculto
            document.getElementById('customClasificadosValue').value = selectedValue;
            // Actualizar el conteo de partidos de PlayOff
            document.getElementById('playoffMatchesCount').textContent = selectedValue > 1 ? (selectedValue - 1) : 0;
            
            // Re-chequear el radio button asociado al formato Liga + Playoff
            const checkedRadio = document.querySelector('input[name="estructura_letra"]:checked');
            if (checkedRadio) {
                // Forzar la actualización visual del resumen si es necesario, aunque con la lógica de envío no es estrictamente necesario.
                const infoInput = document.querySelector(`input[name="estructura_info_${checkedRadio.value}"]`);
                if (infoInput) {
                    try {
                        let item = JSON.parse(infoInput.value);
                        item.Clasificados = selectedValue;
                        item['Partidos Playoff'] = selectedValue - 1;
                        item['Total Partidos'] = item['Partidos Fase'] + (selectedValue - 1);
                        infoInput.value = JSON.stringify(item);
                        
                        // Actualizar el resumen visible para el usuario (opcional pero recomendado)
                        const label = checkedRadio.nextElementSibling;
                        let resumen = `<strong>${checkedRadio.value}) ${item.Formato}</strong><br>`;
                        resumen += `Fase Regular: Liga Única (${item.Rondas === 2 ? 'Ida y Vuelta' : 'Solo Ida'}) con ${item['Partidos Fase']} partidos.<br>`;
                        resumen += `Clasificados al Playoff: ${item.Clasificados}<br>`;
                        resumen += `Partidos Playoff: ${item['Partidos Playoff']}<br>`;
                        resumen += `Total de partidos: ${item['Total Partidos']}`;
                        label.innerHTML = resumen;
                    } catch (e) {
                        console.error("Error al parsear JSON:", e);
                    }
                }
            }
        });
    }
    
    // Listener para cambiar la visibilidad del selector dinámico
    document.getElementById('contenedorEstructuras').addEventListener('change', function(event) {
        if (event.target.name === 'estructura_letra') {
            const letra = event.target.value;
            const infoInput = document.querySelector(`input[name="estructura_info_${letra}"]`);
            if (infoInput) {
                try {
                    const item = JSON.parse(infoInput.value);
                    const isDynamic = item.DynamicPlayoff === true;
                    const selectorDiv = document.getElementById('dynamicClasificadosSelector');
                    
                    if (isDynamic) {
                        selectorDiv.style.display = 'block';
                        const n = item['Total Participantes'];
                        setupClasificadosSelect(n, item.Clasificados);
                        // Disparar el cambio para inicializar el campo oculto y el conteo
                        document.getElementById('clasificadosSelect').dispatchEvent(new Event('change'));
                    } else {
                        selectorDiv.style.display = 'none';
                        document.getElementById('customClasificadosValue').value = '';
                    }
                } catch (e) {
                    console.error("Error al parsear JSON en cambio de radio:", e);
                }
            }
        }
    });
});

function setupClasificadosSelect(total, initialK) {
    const select = document.getElementById('clasificadosSelect');
    select.innerHTML = '';
    
    // Generar opciones de 2 hasta N, favoreciendo potencias de 2 (2, 4, 8, 16...)
    let options = [];
    let k = 2;
    while (k <= total) {
        options.push(k);
        k *= 2;
    }
    // Asegurar que si N no es potencia de 2, la opción N esté presente si no lo está.
    if (!options.includes(total)) {
        options.push(total);
    }
    
    // Eliminar duplicados y ordenar
    options = [...new Set(options)].sort((a, b) => a - b);
    
    // Construir el dropdown
    options.forEach(k_val => {
        if (k_val >= 2) {
            const option = document.createElement('option');
            option.value = k_val;
            option.textContent = `${k_val} Clasificados`;
            select.appendChild(option);
        }
    });
    
    // Seleccionar el valor inicial o el más cercano a 2
    select.value = initialK > 1 ? initialK : (options.length > 0 ? options[0] : 2);
}

function mostrarReglas(id) {
    let baseUrl = "<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'reglas', 'uuid' => '0']) ?>".replace('/0', '/' + id);
    fetch(baseUrl)
        .then(res => res.json())
        .then(data => {
            document.getElementById('modalContenidoReglas').innerHTML = data.html;
            const modal = new bootstrap.Modal(document.getElementById('modalReglas'));
            modal.show();
        })
        .catch(() => {
            document.getElementById('modalContenidoReglas').innerHTML = '<p class="text-danger"><?= __('deporte_padel.no_cargar_reglas') ?></p>';
        });
}

function abrirModalEstructura(id, a_considerar) {
    let baseUrlGuardar = "<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'guardarestructura', 'uuid' => '0']) ?>".replace('/0', '/' + id);
    document.getElementById('formEstructura').action = baseUrlGuardar;
    
    // Limpiar selector dinámico y valor oculto al abrir
    document.getElementById('dynamicClasificadosSelector').style.display = 'none';
    document.getElementById('customClasificadosValue').value = '';
    
    let baseUrlCalcular = "<?= $this->url('ligas.categorias', ['deporte' => $deporte ?? 'padel', 'accion' => 'calcularestructuras', 'uuid' => '0']) ?>".replace('/0', '/' + a_considerar);
    fetch(baseUrlCalcular)
        .then(res => res.json())
        .then(data => {
            const container = document.getElementById('contenedorEstructuras');
            container.innerHTML = '';
            
            data.forEach((item, index) => {
                const letra = String.fromCharCode(65 + index);
                let resumen = `<strong>${letra}) ${item.Formato}</strong><br>`;

                if (item.Formato.includes('Liga')) {
                    const rondas = item.Rondas === 2 ? 'Ida y Vuelta' : 'Solo Ida';
                    resumen += `Fase Regular: Liga Única (${rondas}) con ${item['Partidos Fase']} partidos.<br>`;
                    
                    if (item.DynamicPlayoff) {
                        resumen += `Clasificados al Playoff: <span class="badge bg-warning text-dark">SELECCIÓN DINÁMICA</span> (${item.Clasificados}+ equipos)<br>`;
                    } else if (item.Formato.includes('PlayOff')) {
                        resumen += `Clasificados al Playoff: ${item.Clasificados}<br>`;
                    } else {
                        resumen += `Participantes Totales: ${item['Total Participantes']}<br>`;
                    }
                    resumen += `Partidos Playoff: ${item['Partidos Playoff']}<br>`;
                    resumen += `Total de partidos: ${item['Total Partidos']}`;

                } else { // Formato de Grupos o Solo Playoff (Lógica Existente)
                    if (item.G3 > 0) resumen += `Grupos de 3: ${item.G3}<br>`;
                    if (item.G4A > 0) resumen += `Grupos de 4 (4 fechas): ${item.G4A}<br>`;
                    if (item.G4B > 0) resumen += `Grupos de 4 (6 fechas): ${item.G4B}<br>`;
                    if (item['Partidos Fase'] > 0) resumen += `Partidos en fase de grupos: ${item['Partidos Fase']}<br>`;
                    
                    if (item.Formato === 'Solo Playoff') {
                        resumen += `Playoff de ${item.Clasificados} participantes.<br>`;
                    } else {
                        resumen += `Clasificados al Playoff: ${item.Clasificados}<br>`;
                    }
                    resumen += `Partidos Playoff: ${item['Partidos Playoff']}<br>`;
                    resumen += `Total de partidos: ${item['Total Partidos']}`;
                }


                container.innerHTML += `
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="estructura_letra" value="${letra}" id="op${index}" required>
                        <label class="form-check-label" for="op${index}">
                            ${resumen}
                        </label>
                        <input type="hidden" name="estructura_info_${letra}" value='${JSON.stringify(item)}' data-dynamic="${item.DynamicPlayoff}">
                    </div>
                `;
            });
        })
        .catch(err => {
            console.error("Error al cargar estructuras:", err);
            document.getElementById('contenedorEstructuras').innerHTML = '<p class="text-danger"><?= __('deporte_padel.no_cargar_reglas') ?></p>';
        });
}
</script>

