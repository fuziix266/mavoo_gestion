    <script>
        $(document).ready(function () {
            // Botón Obtener Notificaciones
            $('#obtenerNotificaciones').click(function () {
                $.ajax({
                    url: '<?= $this->url('ligas.notificaciones', ['deporte' => 'padel', 'accion' => 'obtener', 'uuid' => $evento['uuid'] ?? '']) ?>',
                    method: 'POST',
                    data: {
                        _token: '<?= csrf_token() ?>'
                    },
                    success: function (response) {
                        if (response.success) {
                            alert('Éxito: ' + response.message);
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Error: Ocurrió un error al procesar la solicitud');
                    }
                });
            });

            // Botón Enviar Notificación
            $('.enviar-notificacion').click(function () {
                const id = $(this).data('id');
                $.ajax({
                    url: '<?= $this->url("ligas.notificaciones", ["deporte" => "padel", "accion" => "enviar-individual", "uuid" => "UUID_PLACEHOLDER"]) ?>'.replace("UUID_PLACEHOLDER", id),
                    method: 'POST',
                    data: {
                        _token: '<?= csrf_token() ?>'
                    },
                    success: function (response) {
                        if (response.success) {
                            alert('Éxito: ' + response.message);
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Error: Ocurrió un error al procesar la solicitud');
                    }
                });
            });

            // Botón Notificar Todos
            $('#notificarTodos').click(function () {
                $.ajax({
                    url: '<?= $this->url('ligas.notificaciones', ['deporte' => 'padel', 'accion' => 'notificar-todos', 'uuid' => $evento['uuid'] ?? '']) ?>',
                    method: 'POST',
                    data: {
                        _token: '<?= csrf_token() ?>'
                    },
                    success: function (response) {
                        if (response.success) {
                            alert('Éxito: ' + response.message);
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Error: Ocurrió un error al procesar la solicitud');
                    }
                });
            });
        });
    </script>
