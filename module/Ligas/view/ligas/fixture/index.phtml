    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mostrarFixtureBtn = document.getElementById('mostrarFixture');
            const fixtureTableBody = document.getElementById('fixtureTableBody');
            mostrarFixtureBtn.addEventListener('click', function () {
                const eventoId = this.dataset.eventoId;
                fetch('<?= $this->url('ligas.fixture.links', ['deporte' => $deporte]) ?>?evento_id=' + eventoId, {
                    method: 'GET',
                    headers: {
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                        'Accept': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    fixtureTableBody.innerHTML = '';
                    data.data.forEach(row => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td>${row.categoria}</td>
                            <td>${row.lastUpdate}</td>
                            <td>
                                ${row.enlaceEs !== '<?= __('deporte_padel.no_generado') ?>' ? `<a href="${row.enlaceEs}" target="_blank">${row.enlaceEs}</a> <button class="btn btn-sm btn-info copy-btn" data-link="${row.enlaceEs}"><?= __('deporte_padel.copiar') ?></button>` : '<?= __('deporte_padel.no_generado') ?>'}
                            </td>
                            <td>
                                ${row.enlaceEn !== '<?= __('deporte_padel.no_generado') ?>' ? `<a href="${row.enlaceEn}" target="_blank">${row.enlaceEn}</a> <button class="btn btn-sm btn-info copy-btn" data-link="${row.enlaceEn}"><?= __('deporte_padel.copiar') ?></button>` : '<?= __('deporte_padel.no_generado') ?>'}
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary actualizar-fixture" data-uuid="${row.uuid}"><?= __('deporte_padel.actualizar_fixture') ?></button>
                            </td>
                        `;
                        fixtureTableBody.appendChild(tr);
                    });
                    $('#fixtureModal').modal('show');
                })
                .catch(error => {
                    console.error('<?= __('deporte_padel.error_cargar_fixtures') ?>:', error);
                    alert('<?= __('deporte_padel.error_cargar_fixtures') ?>');
            });
        });
    </script>
    <script>
