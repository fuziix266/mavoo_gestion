        for (let i = 1; i <= 5; i++) {
            let scoreA = $(`#set${i}ParejaA`).val();
            let scoreB = $(`#set${i}ParejaB`).val();
            if (scoreA !== '' && parseInt(scoreA, 10) > 0 && scoreB === '') { scoreB = '0'; }
            if (scoreB !== '' && parseInt(scoreB, 10) > 0 && scoreA === '') { scoreA = '0'; }
            if (scoreA !== '' && scoreB !== '') {
                const a = parseInt(scoreA);
                const b = parseInt(scoreB);
                if (a === b) {
                    alert(`<?= __('deporte_padel.set') ?> ${i} <?= __('deporte_padel.no_puntajes_iguales') ?>`);
                    return;
                }
                sets.push([a, b]);
                setCount++;
            } else {
                sets.push(null);
            }
