                );
                if (response.duelo) {
                    for (let i = 0; i < 5; i++) {
                        if (response.duelo.sets && response.duelo.sets[i]) {
                            $(`#set${i + 1}ParejaA`).val(response.duelo.sets[i][0]);
                            $(`#set${i + 1}ParejaB`).val(response.duelo.sets[i][1]);
                        }
                    }
                    $('#horaInicio').val(
                        response.duelo.hora_inicio
                            ? response.duelo.hora_inicio.replace(' ', 'T').slice(0,16)
                            : ''
                    );
                    $('#horaFin').val(
                        response.duelo.hora_fin
                            ? response.duelo.hora_fin.replace(' ', 'T').slice(0, 16)
                            : new Date().toISOString().slice(0, 16)
                    );
                } else {
                    const now = new Date().toISOString().slice(0, 16);
                    $('#horaInicio').val(now);
                    $('#horaFin').val(now);
                }
                cerrarCargando();
