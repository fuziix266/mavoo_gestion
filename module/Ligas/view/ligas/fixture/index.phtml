                            for (const [letra, grupo] of Object.entries(response.grupos)) {
                                html += `<h5 style="color: #007bff; margin-top: 20px;"><?= __('deporte_padel.tabla_posiciones_grupo') ?> ${letra}</h5>`;
                                html += `
