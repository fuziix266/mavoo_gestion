                                    `;
                                });
                                html += `</tbody></table>`;
                                html += `<h5 style="color: #007bff; margin-top: 20px;"><?= __('deporte_padel.partidos_grupo') ?> ${letra}</h5>`;
                                html += `
                                    <table class="table table-striped table-bordered" style="background: white; border-radius: 8px;">
                                        <thead style="background: linear-gradient(90deg, #28a745, #20c997); color: white;">
                                            <tr>
                                                <th><?= __('deporte_padel.partido') ?></th>
                                                <th><?= __('deporte_padel.pareja_a') ?></th>
                                                <th><?= __('deporte_padel.resultado') ?></th>
                                                <th><?= __('deporte_padel.pareja_b') ?></th>
                                                <th><?= __('deporte_padel.fecha') ?></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                `;
                                grupo.partidos.forEach(partido => {
                                    const sets = partido.resultado.split('\n').filter(set => set && set !== '<?= __('deporte_padel.no_jugado') ?>');
                                    const resultadoHtml = partido.resultado === '<?= __('deporte_padel.no_jugado') ?>' ? '<?= __('deporte_padel.no_jugado') ?>' : `<div class="resultado-marcador">${sets.map(set => {
                                        const [juegosA, juegosB] = set.split('-').map(Number);
                                        const claseGanador = juegosA > juegosB ? 'set-ganador' : (juegosB > juegosA ? 'set-ganador' : '');
                                        return `<div class="${claseGanador}">${set}</div>`;
                                    }).join('')}</div>`;
                                    html += `
                                        <tr>
                                            <td><?= __('deporte_padel.partido') ?> ${partido.index}</td>
                                            <td class="pareja-cell"><strong>${partido.nombreA.split('\n')[0]}</strong><span>${partido.nombreA.split('\n').slice(1).join('<br>')}</span></td>
                                            <td class="resultado-cell">${resultadoHtml}</td>
                                            <td class="pareja-cell"><strong>${partido.nombreB.split('\n')[0]}</strong><span>${partido.nombreB.split('\n').slice(1).join('<br>')}</span></td>
                                            <td>${partido.fecha}</td>
                                        </tr>
                                    `;
                                });
                                html += `</tbody></table>`;
                            }
                        } else if (fase === 'eliminatorias') {
                            if (Object.keys(response.eliminatorias).length === 0) {
                                html += `<p><?= __('deporte_padel.no_partidos_eliminatorias') ?></p>`;
                            } else {
                                for (const [faseNombre, partidos] of Object.entries(response.eliminatorias)) {
                                    html += `<h5 style="color: #007bff; margin-top: 20px;"><?= __('deporte_padel.partidos') ?> ${faseNombre}</h5>`;
                                    html += `
                                        <table class="table table-striped table-bordered" style="background: white; border-radius: 8px;">
                                            <thead style="${faseNombre.toUpperCase() === 'FINAL' ? 'background: linear-gradient(90deg, #ffd700, #ffaa00); color: #333;' : 'background: linear-gradient(90deg, #ff6b6b, #ff8e53); color: white;'}">
                                                <tr>
                                                    <th><?= __('deporte_padel.partido') ?></th>
                                                    <th><?= __('deporte_padel.pareja_a') ?></th>
                                                    <th><?= __('deporte_padel.resultado') ?></th>
                                                    <th><?= __('deporte_padel.pareja_b') ?></th>
                                                    <th><?= __('deporte_padel.fecha') ?></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                    `;
                                    partidos.forEach(partido => {
                                        const sets = partido.resultado.split('\n').filter(set => set && set !== '<?= __('deporte_padel.no_jugado') ?>');
                                        const resultadoHtml = partido.resultado === '<?= __('deporte_padel.no_jugado') ?>' ? '<?= __('deporte_padel.no_jugado') ?>' : `<div class="resultado-marcador">${sets.map(set => {
                                            const [juegosA, juegosB] = set.split('-').map(Number);
                                            const claseGanador = juegosA > juegosB ? 'set-ganador' : (juegosB > juegosA ? 'set-ganador' : '');
                                            return `<div class="${claseGanador}">${set}</div>`;
                                        }).join('')}</div>`;
                                        html += `
                                            <tr>
                                                <td><?= __('deporte_padel.partido') ?> ${partido.index}</td>
                                                <td class="pareja-cell"><strong>${partido.nombreA.split('\n')[0]}</strong><span>${partido.nombreA.split('\n').slice(1).join('<br>')}</span></td>
                                                <td class="resultado-cell">${resultadoHtml}</td>
                                                <td class="pareja-cell"><strong>${partido.nombreB.split('\n')[0]}</strong><span>${partido.nombreB.split('\n').slice(1).join('<br>')}</span></td>
                                                <td>${partido.fecha}</td>
                                            </tr>
                                        `;
                                    });
                                    html += `</tbody></table>`;
                                }
                            }
                        }
                        $('#rankingContent').html(html);
                        $('#rankingModal').modal('show');
                    },
                    error: function(xhr) {
                        console.error('<?= __('deporte_padel.error_ajax') ?>:', xhr.responseJSON, 'Status:', xhr.status, 'StatusText:', xhr.statusText);
                        alert('<?= __('deporte_padel.error_cargar_ranking') ?>: ' + (xhr.responseJSON?.error || '<?= __('deporte_padel.error_desconocido') ?>'));
                    }
                });
            });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function() {
            $('.agregar-partido').click(function() {
                const sedeId = $(this).data('sede-id');
                const eventoId = $(this).data('evento-id');
                const bloque = $(this).data('bloque');
                const cancha = $(this).data('cancha');
                $('#agregarPartidoModal').modal('show');
                $('#categoriaSelect').html('<option value=""><?= __('deporte_padel.seleccione_categoria') ?></option>');
                $('#partidoSelect').html('<option value=""><?= __('deporte_padel.seleccione_partido') ?></option>').prop('disabled', true);
                $('#agregarPartidoBtn').prop('disabled', true);
                $.ajax({
                    url: '<?= $this->url("ligas.fixture", ["deporte" => $deporte, "accion" => "categorias"]) ?>',
                    method: 'POST',
                    data: { evento_id: eventoId, _token: '<?= csrf_token() ?>' },
                    success: function(response) {
                        if (response.success) {
                            response.categorias.forEach(categoria => {
                                $('#categoriaSelect').append(`<option value="${categoria.id}">${categoria.titulo} ${categoria.subtitulo}</option>`);
                            });
                        }
                    },
                    error: function(xhr) {
                        alert('<?= __('deporte_padel.error_cargar_categorias') ?>: ' + xhr.responseJSON.error);
                    }
                });
                $('#agregarPartidoBtn').off('click').on('click', function() {
                    const categoriaId = $('#categoriaSelect').val();
                    const partidoIdx = $('#partidoSelect').val();
                    if (!categoriaId || !partidoIdx) {
                        alert('<?= __('deporte_padel.seleccione_categoria_partido') ?>');
                        return;
                    }
                    $.ajax({
                        url: '<?= $this->url("ligas.fixture", ["deporte" => $deporte, "accion" => "agregar"]) ?>',
                        method: 'POST',
                        data: {
                            evento_id: eventoId,
                            sede_id: sedeId,
                            bloque: bloque,
                            cancha: cancha,
                            categoria_id: categoriaId,
                            partido_idx: partidoIdx,
                            _token: '<?= csrf_token() ?>'
                        },
                        success: function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('<?= __('deporte_padel.error') ?>: ' + response.error);
                            }
                        },
                        error: function(xhr) {
                            alert('<?= __('deporte_padel.error_agregar_partido') ?>: ' + xhr.responseJSON.error);
                        }
                    });
                });
            });
            $('#categoriaSelect').change(function() {
                const categoriaId = $(this).val();
                $('#partidoSelect').html('<option value=""><?= __('deporte_padel.seleccione_partido') ?></option>').prop('disabled', true);
                $('#agregarPartidoBtn').prop('disabled', true);
                if (categoriaId) {
                    $.ajax({
                        url: '<?= $this->url("ligas.fixture", ["deporte" => $deporte, "accion" => "partidos"]) ?>',
                        method: 'POST',
                        data: { categoria_id: categoriaId, _token: '<?= csrf_token() ?>' },
                        success: function(response) {
                            if (response.success) {
                                response.partidos.forEach(partido => {
                                    $('#partidoSelect').append(`<option value="${partido.partido_idx}"><?= __('deporte_padel.partido') ?> ${partido.partido_idx} - ${partido.fase}${partido.letra ? ' ' + partido.letra : ''}</option>`);
                                });
                                $('#partidoSelect').prop('disabled', false);
                                $('#agregarPartidoBtn').prop('disabled', false);
                            }
                        },
                        error: function(xhr) {
                            alert('<?= __('deporte_padel.error_cargar_partidos') ?>: ' + xhr.responseJSON.error);
                        }
                    });
                }
            });
            let moverPartidoData = null;
            $('.mover-partido').click(function() {
                moverPartidoData = {
                    sede_id: $(this).data('sede-id'),
                    bloque: $(this).data('bloque'),
                    cancha: $(this).data('cancha'),
                    categoria_id: $(this).data('categoria-id'),
                    partido_idx: $(this).data('partido-idx'),
                    evento_id: $(this).data('evento-id')
                };
                $('.toggle-bloqueo').each(function() {
                    if ($(this).find('i').hasClass('ti-lock-open')) {
                        const sedeId = $(this).data('sede-id');
                        const bloque = $(this).data('bloque');
                        const cancha = $(this).data('cancha');
                        $(this).after(`<button class="mover-aqui" data-sede-id="${sedeId}" data-bloque="${bloque}" data-cancha="${cancha}" style="font-size: 16px; color: #007bff; border: none; background: none; cursor: pointer;"><i class="ti ti-check"></i></button>`);
                    }
                });
            });
            $(document).on('click', '.mover-aqui', function() {
                const nuevaSedeId = $(this).data('sede-id');
                const nuevoBloque = $(this).data('bloque');
                const nuevaCancha = $(this).data('cancha');
                $.ajax({
                    url: '<?= $this->url("ligas.fixture", ["deporte" => $deporte, "accion" => "validar-movimiento"]) ?>',
                    method: 'POST',
                    data: {
                        evento_id: moverPartidoData.evento_id,
                        categoria_id: moverPartidoData.categoria_id,
                        partido_idx: moverPartidoData.partido_idx,
                        sede_id: nuevaSedeId,
                        bloque: nuevoBloque,
                        cancha: nuevaCancha,
                        bloque_actual: moverPartidoData.bloque,
                        _token: '<?= csrf_token() ?>'
                    },
                    success: function(response) {
                        if (response.conflictos.length > 0) {
                            const mensaje = response.conflictos.join('\n');
                            if (confirm(mensaje + '\n<?= __('deporte_padel.confirmar_movimiento') ?>')) {
                                moverPartido(nuevaSedeId, nuevoBloque, nuevaCancha);
                            } else {
                                $('.mover-aqui').remove();
                            }
                        } else {
                            moverPartido(nuevaSedeId, nuevoBloque, nuevaCancha);
                        }
                    },
                    error: function(xhr) {
                        alert('<?= __('deporte_padel.error_validar_movimiento') ?>: ' + xhr.responseJSON.error);
                    }
                });
            });
            function moverPartido(nuevaSedeId, nuevoBloque, nuevaCancha) {
                $.ajax({
                    url: '<?= $this->url("ligas.fixture", ["deporte" => $deporte, "accion" => "mover"]) ?>',
                    method: 'POST',
                    data: {
                        evento_id: moverPartidoData.evento_id,
                        sede_id: moverPartidoData.sede_id,
                        bloque: moverPartidoData.bloque,
                        cancha: moverPartidoData.cancha,
                        categoria_id: moverPartidoData.categoria_id,
                        partido_idx: moverPartidoData.partido_idx,
                        nueva_sede_id: nuevaSedeId,
                        nuevo_bloque: nuevoBloque,
                        nueva_cancha: nuevaCancha,
                        _token: '<?= csrf_token() ?>'
                    },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('<?= __('deporte_padel.error') ?>: ' + response.error);
                        }
                    },
                    error: function(xhr) {
                        alert('<?= __('deporte_padel.error_mover_partido') ?>: ' + xhr.responseJSON.error);
                    }
                });
            }
            $('.iniciar-partido').click(function() {
                const sedeId = $(this).data('sede-id');
                const eventoId = $(this).data('evento-id');
                const bloque = $(this).data('bloque');
                const cancha = $(this).data('cancha');
                const categoriaId = $(this).data('categoria-id');
                const partidoIdx = $(this).data('partido-idx');
                const horaInicio = new Date().toISOString();
                $.ajax({
                    url: '<?= $this->url("ligas.fixture", ["deporte" => $deporte, "accion" => "iniciar"]) ?>',
                    method: 'POST',
                    data: {
                        evento_id: eventoId,
                        sede_id: sedeId,
                        bloque: bloque,
                        cancha: cancha,
                        categoria_id: categoriaId,
                        partido_idx: partidoIdx,
                        hora_inicio: horaInicio,
                        _token: '<?= csrf_token() ?>'
                    },
                    success: function(response) {
                        if (response.success) {
                            $(`button[data-sede-id="${sedeId}"][data-bloque="${bloque}"][data-cancha="${cancha}"]`).closest('td').css('background', '#e6ffe6');
                            $(`button[data-sede-id="${sedeId}"][data-bloque="${bloque}"][data-cancha="${cancha}"].iniciar-partido`).hide();
                            $(`button[data-sede-id="${sedeId}"][data-bloque="${bloque}"][data-cancha="${cancha}"].registrar-resultado`).show();
                        } else {
                            alert('<?= __('deporte_padel.error') ?>: ' + response.error);
                        }
                    },
                    error: function(xhr) {
                        alert('<?= __('deporte_padel.error_iniciar_partido') ?>: ' + xhr.responseJSON.error);
                    }
                });
            });


$('.registrar-resultado, .editar-resultado').click(function() {
    cargando();
    const eventoId = $(this).data('evento-id');
    const sedeId = $(this).data('sede-id');
    const bloque = $(this).data('bloque');
    const cancha = $(this).data('cancha');
    const categoriaId = $(this).data('categoria-id');
    const partidoIdx = $(this).data('partido-idx');
    const accion = $(this).hasClass('registrar-resultado') ? 'registrar' : 'editar';
    $('#resultadoModal').modal('show');
    $('#resultadoModalLabel').text(accion === 'editar' ? '<?= __('deporte_padel.editar_resultado') ?>' : '<?= __('deporte_padel.registrar_resultado') ?>');
    $('#parejaANombre').text('');
    $('#parejaBNombre').text('');
