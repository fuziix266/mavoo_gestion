                                `;
                                grupo.posiciones.forEach(pos => {
                                    html += `
                                        <tr>
                                            <td class="pareja-cell"><strong><?= __('deporte_padel.pareja') ?> ${pos.orden}</strong><span>${pos.nombre.split('\n').slice(1).join('<br>')}</span></td>
                                            <td>${pos.puntos}</td>
                                            <td>${pos.sets}</td>
                                            <td>${pos.juegos}</td>
