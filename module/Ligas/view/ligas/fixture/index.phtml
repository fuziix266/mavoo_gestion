                                                <th><?= __('deporte_padel.puntos') ?></th>
                                                <th><?= __('deporte_padel.sets') ?></th>
                                                <th><?= __('deporte_padel.juegos') ?></th>
                                                <th><?= __('deporte_padel.ranking') ?></th>
