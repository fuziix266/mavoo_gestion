<?php
$deporte = $this->deporte;
$evento = $this->evento;
$eventos = $this->eventos;
$ultimoAjuste = $this->ultimoAjuste;
$paises = $this->paises;

// Mock menuEV until we refactor the global menu injection mechanism
$menuEV = $this->menuEV ?? (object)[
    'uuid'           => $evento['uuid'] ?? '',
    'sedes'          => true,
    'categorias'     => true,
    'nominas'        => true,
    'fixture'        => true,
    'ranking'        => true,
    'notificaciones' => true,
    'logs'           => true
];

$deporteLower = strtolower($deporte);
// Se agrega '/' final para que el match también funcione en la ruta base
// (p.ej. '/ligas/futbol/ajustes' sin slash final), no solo en subrutas.
$uri = $_SERVER['REQUEST_URI'] . '/';

$items = [
    [
        'match' => '/ajustes/',
        'href'  => '/ligas/' . $deporteLower . '/ajustes',
        'icon'  => 'ph-gear',
        'label' => 'Ajustes Generales',
        'hint'  => 'Configuración básica',
        'show'  => true,
    ],
    [
        'match' => '/sedes/',
        'href'  => $this->url('ligas.sedes', ['deporte' => $deporteLower]),
        'icon'  => 'ph-buildings',
        'label' => 'Días y Sedes',
        'hint'  => 'Ubicaciones y horarios',
        'show'  => $menuEV->sedes,
    ],
    [
        'match' => '/categorias/',
        'href'  => $this->url('ligas.categorias', ['deporte' => $deporteLower]),
        'icon'  => 'ph-list-checks',
        'label' => 'Categorías y Reglas',
        'hint'  => 'Definición de normativas',
        'show'  => $menuEV->categorias,
    ],
    [
        'match' => '/nominas/',
        'href'  => $this->url('ligas.nominas', ['deporte' => $deporteLower]),
        'icon'  => 'ph-users-three',
        'label' => 'Nóminas',
        'hint'  => 'Jugadores inscritos',
        'show'  => $menuEV->nominas,
    ],
    [
        'match' => '/fixture/',
        'href'  => $this->url('ligas.fixture', ['deporte' => $deporteLower]),
        'icon'  => 'ph-calendar',
        'label' => 'Programación',
        'hint'  => 'Calendario de eventos',
        'show'  => $menuEV->fixture,
    ],
    [
        'match' => '/ranking/',
        'href'  => $this->url('ligas.ranking', ['deporte' => $deporteLower]),
        'icon'  => 'ph-trophy',
        'label' => 'Ranking',
        'hint'  => 'Clasificaciones',
        'show'  => $menuEV->ranking,
    ],
    [
        'match' => '/notificaciones/',
        'href'  => $this->url('ligas.notificaciones', ['deporte' => $deporteLower]),
        'icon'  => 'ph-bell',
        'label' => 'Notificaciones',
        'hint'  => 'Alertas y comunicaciones',
        'show'  => $menuEV->notificaciones,
    ],
    [
        'match' => '/logs/',
        'href'  => $this->url('ligas.logs', ['deporte' => $deporteLower]),
        'icon'  => 'ph-list-magnifying-glass',
        'label' => 'Logs',
        'hint'  => 'Historial de actividades',
        'show'  => $menuEV->logs,
    ],
];
?>
<ul class="mavoo-tabbar">
<?php foreach ($items as $item): ?>
    <?php if (! $item['show']) continue; ?>
    <?php $active = str_contains($uri, $item['match']); ?>
    <li class="mavoo-tabbar__item<?= $active ? ' active' : '' ?>">
        <a href="<?= $this->escapeUrl($item['href']) ?>" class="mavoo-tabbar__link">
            <i class="ph-fill <?= $item['icon'] ?> mavoo-tabbar__icon"></i>
            <span class="mavoo-tabbar__label"><?= $this->escapeHtml($item['label']) ?></span>
            <span class="mavoo-tabbar__hint"><?= $this->escapeHtml($item['hint']) ?></span>
        </a>
    </li>
<?php endforeach; ?>
</ul>
