$baseRankingEdit = $this->url('ligas.ranking', ['deporte' => $deporte, 'accion' => 'edit', 'uuid' => 'UUID_PLACEHOLDER']);
$baseRankingDelete = $this->url('ligas.ranking', ['deporte' => $deporte, 'accion' => 'delete', 'uuid' => 'UUID_PLACEHOLDER']);
?>
<script>
const RANKING_EDIT_URL = <?= json_encode($baseRankingEdit) ?>;
const RANKING_DELETE_URL = <?= json_encode($baseRankingDelete) ?>;
</script>
<script>
    const searchInput = document.querySelector('.search');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const filter = searchInput.value.toLowerCase();
            const rows = document.querySelectorAll('#t-data tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    }
    const searchInputRanking = document.querySelector('.search-ranking');
    if (searchInputRanking) {
        searchInputRanking.addEventListener('input', function() {
            const filter = searchInputRanking.value.toLowerCase();
            const rows = document.querySelectorAll('#t-data-ranking tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    }
    document.querySelectorAll('.btn-eliminar-ranking').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            const nombre = this.getAttribute('data-nombre');
            let message = "<?= __('deporte_padel.confirm_eliminar_ranking') ?>";
            if (confirm(message.replace(':nombre', nombre))) {
                form.submit();
            }
        });
    });
    document.querySelectorAll('.btn-aplicar-ranking').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            if (confirm("<?= __('deporte_padel.confirm_aplicar_ranking') ?>")) {
                cargando();
                form.submit();
            }
        });
    });
    document.querySelectorAll('.btn-desasociar-ranking').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            if (confirm("<?= __('deporte_padel.confirm_desasociar_ranking') ?>")) {
                cargando();
                form.submit();
            }
        });
    });
    const asociarRankingForm = document.getElementById('asociarRankingForm');
    if (asociarRankingForm) {
        asociarRankingForm.addEventListener('submit', function(e) {
            e.preventDefault();
            if (confirm("<?= __('deporte_padel.confirm_asociar_ranking') ?>")) {
                cargando();
                this.submit();
            }
        });
    }
    const editManualModal = document.getElementById('editManualModal');
    if (editManualModal) {
        editManualModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const row = button.closest('tr');
            const form = editManualModal.querySelector('form');
            const rankingUuid = row.dataset.uuid;
            form.action = '<?= $this->url('ligas.ranking', ['deporte' => $deporte ?? 'padel', 'accion' => 'manual', 'uuid' => $evento['uuid'] ?? '']) ?>/:ranking_uuid'.replace(':ranking_uuid', rankingUuid);
            form.querySelector('select[name="categoria_manual"]').value = row.dataset.categoria_manual || '';
            form.querySelector('input[name="puntos_manual"]').value = row.dataset.puntos_manual || '';
        });
    }
    const rankingModal = document.getElementById('rankingModal');
    if (rankingModal) {
        rankingModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const form = rankingModal.querySelector('#rankingForm');
            const modalTitle = rankingModal.querySelector('.modal-title');
            const submitBtn = rankingModal.querySelector('#submitBtn');
            if (button.dataset.mode === 'edit') {
                modalTitle.textContent = "<?= __('deporte_padel.editar_ranking') ?>";
                submitBtn.textContent = "<?= __('deporte_padel.actualizar') ?>";
                form.action = RANKING_EDIT_URL.replace('UUID_PLACEHOLDER', button.closest('tr').dataset.uuid);
                form.querySelector('#ranking_uuid').value = button.closest('tr').dataset.uuid;
                form.querySelector('#nombre_ranking').value = button.closest('tr').dataset.nombre;
                form.querySelector('#puntos_inscribirse').value = button.closest('tr').dataset.inscribirse;
                form.querySelector('#puntos_jugar_partido').value = button.closest('tr').dataset.jugar_partido;
                form.querySelector('#puntos_fase_grupos').value = button.closest('tr').dataset.fase_grupos;
                form.querySelector('#puntos_32avos').value = button.closest('tr').dataset['32avos'];
                form.querySelector('#puntos_16avos').value = button.closest('tr').dataset['16avos'];
                form.querySelector('#puntos_8vos').value = button.closest('tr').dataset['8vos'];
                form.querySelector('#puntos_cuartos').value = button.closest('tr').dataset.cuartos;
                form.querySelector('#puntos_semis').value = button.closest('tr').dataset.semis;
                form.querySelector('#puntos_subcampeon').value = button.closest('tr').dataset.subcampeon;
                form.querySelector('#puntos_ganador').value = button.closest('tr').dataset.ganador;
            } else {
                modalTitle.textContent = "<?= __('deporte_padel.agregar_ranking') ?>";
                submitBtn.textContent = "<?= __('deporte_padel.guardar') ?>";
                form.action = '<?= $this->url('ligas.ranking', ['deporte' => $deporte ?? 'padel', 'accion' => 'store', 'uuid' => $evento['uuid'] ?? '']) ?>';
                form.querySelector('#ranking_uuid').value = '';
                form.querySelector('#nombre_ranking').value = 'Nuevo Ranking';
                form.querySelector('#puntos_inscribirse').value = '0';
                form.querySelector('#puntos_jugar_partido').value = '0';
                form.querySelector('#puntos_fase_grupos').value = '10';
                form.querySelector('#puntos_32avos').value = '30';
                form.querySelector('#puntos_16avos').value = '60';
                form.querySelector('#puntos_8vos').value = '125';
                form.querySelector('#puntos_cuartos').value = '250';
                form.querySelector('#puntos_semis').value = '500';
                form.querySelector('#puntos_subcampeon').value = '750';
                form.querySelector('#puntos_ganador').value = '1000';
            }
        });
    }
    document.querySelectorAll('.copy-url-btn').forEach(button => {
        button.addEventListener('click', function() {
            const url = this.getAttribute('data-url');
            navigator.clipboard.writeText(url).then(() => {
                alert("<?= __('deporte_padel.url_copiada') ?>");
            });
        });
    });
</script>


