# =============================================================================
# Variables de entorno para Mavoo Gestion (Laminas)
# =============================================================================
# Copiar a `.env` y rellenar con los valores reales del entorno.
# En Dokploy, inyectar via Environment Variables de la aplicacion.
# =============================================================================

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mavoo_gestion
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
